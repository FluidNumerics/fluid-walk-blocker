#!/bin/sh
# guard.sh -- Layer 1 of two guardrails for @@DISPLAY_NAME@@.
#
# GENERATED by `walk-blocker build` from search_rules.py, site.toml and the
# template node/shim/guard.sh.in. Do not edit this file; edit the table, the
# template or the site configuration and rebuild (ADR-0013).
#
# THIS LAYER IS ADVISORY, NOT ENFORCEMENT. It is a PATH shim. `/usr/bin/find`
# skips it. `uvx rg` resolves out of an ephemeral environment that never sees
# this PATH. So does any script that sets its own PATH, any container, any
# scheduler job script, and any shell function that shadows a wrapped name.
# So does `ssh host 'bash -c "find ..."'` on a site whose bash reads its
# system startup file only for a TOP-LEVEL remote shell: a nested one never
# puts this directory on PATH at all -- measured at a reference deployment,
# see ADR-0008. And nothing in argv reveals that this is the sixteenth
# concurrent child of an `xargs -P16`, each individually bounded and
# collectively a full walk. That is not a bug to be fixed -- it is precisely
# why Layer 2, the reaper, exists (ADR-0001). Describing this as a sandbox
# would invite reliance it cannot support.
#
# More ways around it are env vars this file itself reads: WALK_BLOCKER_MOUNTS
# (a test seam for sg_load_mounts -- pointed at an empty table it sees no
# expensive mounts and has no opinion), WALK_BLOCKER_SHIM_DIR (which directory
# sg_resolve skips while finding the real binary), WALK_BLOCKER_FSTYPES (which
# filesystem types count as expensive at all) and WALK_BLOCKER_DEPTH_BY_MOUNT
# (the per-mount depth ceiling). All four are audited the same way
# WALK_BLOCKER_UNSCOPED is, when and only when they actually change the
# outcome -- see sg_audit_emit() and its unaudited_seam callers below.
# WALK_BLOCKER_AUDIT names an optional file sink for those records and is not
# a way around anything. These six are the whole list; none gains a sibling
# that carries a site value (ADR-0013).
#
# Its job is narrower and worth doing: make the naive invocation fail in under
# a second with an error that names the cheap alternative.
#
# sh, not Python: grep sits on the hot path of every pipeline on a login node,
# and the non-traversing case (`ps aux | grep sshd`, the overwhelming
# majority) has to exec the real binary before any mount lookup happens.
# Measured at a reference deployment, an interpreter start alone cost roughly
# an order of magnitude more than the whole fast path does in sh (ADR-0015);
# the site's own budgets are measure.sh arguments, not constants here.
#
# One dispatcher, symlinked under every wrapped name; basename $0 selects the
# profile. Busybox pattern.

# No globbing anywhere in here. Several loops iterate an unquoted variable to
# word-split it (PATH, a flag list, a path's components), and a `*` in someone's
# argv must not become a filesystem lookup inside the guard.
set -f

sg_tool=${0##*/}

# --- prologue ---------------------------------------------------------------
# Everything from here to the resolver runs on EVERY invocation, before the
# decision, and forks nothing: parameter expansion and `case` only. The seam
# helpers below run only when a caller set the seam they serve, which no
# production invocation does.

# WALK_BLOCKER_FSTYPES/WALK_BLOCKER_DEPTH_BY_MOUNT are colon-separated, matching
# search_rules.py's own convention (and PATH's); the SG_* lists below are
# space-separated, the form every consumer in this file already iterates with
# default IFS. Sets sg_c2s.
sg_colon_to_space() {
    sg_c2s=''
    sg_c2s_rest=$1
    while [ -n "$sg_c2s_rest" ]; do
        sg_c2s_one=${sg_c2s_rest%%:*}
        case "$sg_c2s_rest" in
            *:*) sg_c2s_rest=${sg_c2s_rest#*:} ;;
            *) sg_c2s_rest='' ;;
        esac
        [ -n "$sg_c2s_one" ] && sg_c2s="$sg_c2s $sg_c2s_one"
    done
}

# One fnmatch-style glob -> one anchored POSIX ERE, so the awk mount reader can
# ask `$3 ~ re` the same question the sh reader asks with `case`. `*` and `?`
# are the wildcards; a bracket expression passes through, with a leading `!`
# spelled `^`; every other ERE metacharacter is escaped. The twin of
# glob_to_ere() in the renderer, which compiles the default list the same way;
# this one runs only when WALK_BLOCKER_FSTYPES replaces that list, and a test
# drives both against one set of globs. Sets sg_ere.
sg_glob_to_ere() {
    sg_ere='^'
    sg_ge_rest=$1
    sg_ge_prev=''
    while [ -n "$sg_ge_rest" ]; do
        sg_ge_c=${sg_ge_rest%"${sg_ge_rest#?}"}
        sg_ge_rest=${sg_ge_rest#?}
        case "$sg_ge_c" in
            '*') sg_ere="$sg_ere.*" ;;
            '?') sg_ere="$sg_ere." ;;
            '!')
                if [ "$sg_ge_prev" = '[' ]; then
                    sg_ere="$sg_ere^"
                else
                    sg_ere="$sg_ere!"
                fi
                ;;
            '['|']') sg_ere=$sg_ere$sg_ge_c ;;
            '.'|'+'|'('|')'|'{'|'}'|'^'|'$'|'|'|'\') sg_ere="$sg_ere\\$sg_ge_c" ;;
            *) sg_ere=$sg_ere$sg_ge_c ;;
        esac
        sg_ge_prev=$sg_ge_c
    done
    sg_ere="$sg_ere\$"
}

# Every glob in $1, converted and space-joined. Sets sg_erelist.
sg_globs_to_ere_list() {
    sg_erelist=''
    for sg_gl in $1; do
        sg_glob_to_ere "$sg_gl"
        sg_erelist="$sg_erelist $sg_ere"
    done
}

# The compiled site values, as literals (ADR-0013). Every `_TRUSTED` copy is
# what a seam check further down re-judges against, so none of them is
# overridable: an override that could shadow the check meant to catch it
# would be no check at all.
#
# SG_FSTYPES is the site's `[filesystems].remote_fstypes`: fnmatch globs,
# worst first, space-separated. SG_FSTYPES_RE is the same list as anchored
# EREs for awk. SG_PROXY is `[filesystems].remote_proxy`. SG_MOUNT_OVERRIDES
# is `[[filesystems.mounts]]`, one `PATH=CLASS` or `PATH=CLASS=MAXDEPTH` token
# per mount, space-separated -- safe to word-split because a mount point
# containing whitespace is skipped by sg_load_mounts and the schema refuses
# one containing `=`, so neither can appear here to be split wrongly.
SG_FSTYPES_TRUSTED='@@FSTYPES@@'
SG_FSTYPES_RE_TRUSTED='@@REMOTE_FSTYPES_RE@@'
SG_PROXY=@@REMOTE_PROXY@@
SG_MOUNT_OVERRIDES_TRUSTED='@@MOUNT_OVERRIDES@@'
SG_MOUNTS_TRUSTED='@@MOUNTS_DEFAULT@@'
SG_VERSION='@@VERSION@@'
SG_MAXDEPTH=@@MAXDEPTH@@
SG_DEPTH_ALLOWANCE_MAX=@@DEPTH_ALLOWANCE_MAX@@
SG_UNSCOPED_DEPTH=@@UNSCOPED_DEPTH@@
# The install's own bin directory, which sg_resolve never resolves back into.
SG_BIN_DIR='@@BIN_DIR@@'

# WALK_BLOCKER_FSTYPES is a live runtime seam over the type list -- a test
# seam, so the suite can drive both consumers against a fixture. A value baked
# in at build time and never consulted would let the seam change what the
# table (Layer 2) reported without changing what this shim (Layer 1) refused;
# so it is read here, and the seam check further down re-judges the same
# argv against the _TRUSTED copy and audits a divergence.
if [ -n "$WALK_BLOCKER_FSTYPES" ]; then
    sg_colon_to_space "$WALK_BLOCKER_FSTYPES"
    SG_FSTYPES=$sg_c2s
    sg_globs_to_ere_list "$SG_FSTYPES"
    SG_FSTYPES_RE=$sg_erelist
else
    SG_FSTYPES=$SG_FSTYPES_TRUSTED
    SG_FSTYPES_RE=$SG_FSTYPES_RE_TRUSTED
fi

# WALK_BLOCKER_DEPTH_BY_MOUNT is the live runtime seam over the per-mount
# depth ceiling, kept in its `/mount=N` colon-separated form. When it is
# PRESENT at all -- an empty value included -- it replaces every compiled
# maxdepth, exactly as Policy.from_env() does: each compiled override keeps
# its class and loses its depth, then every valid pair sets a depth, adding an
# `expensive` override for a mount the compiled table did not list. A pair
# that is not `/absolute=digits`, or whose depth is above the allowance
# maximum, is DROPPED toward the restrictive answer rather than clamped, so a
# fat-fingered `/home=999` falls back to the global ceiling. Sets
# SG_MOUNT_OVERRIDES.
sg_depth_seam() {
    SG_MOUNT_OVERRIDES=''
    for sg_ds_o in $SG_MOUNT_OVERRIDES_TRUSTED; do
        sg_ds_c=${sg_ds_o#*=}
        SG_MOUNT_OVERRIDES="$SG_MOUNT_OVERRIDES ${sg_ds_o%%=*}=${sg_ds_c%%=*}"
    done
    for sg_ds_pair in $1; do
        case "$sg_ds_pair" in
            /*=*) ;;
            *) continue ;;
        esac
        sg_ds_m=${sg_ds_pair%%=*}
        sg_ds_d=${sg_ds_pair#*=}
        case "$sg_ds_d" in
            ''|*[!0-9]*) continue ;;
        esac
        [ "$sg_ds_d" -le "$SG_DEPTH_ALLOWANCE_MAX" ] || continue
        # Trailing slashes stripped, as the table keys its mounts.
        while [ "${sg_ds_m%/}" != "$sg_ds_m" ]; do sg_ds_m=${sg_ds_m%/}; done
        [ -n "$sg_ds_m" ] || sg_ds_m=/
        sg_ds_new=''
        sg_ds_found=0
        for sg_ds_o in $SG_MOUNT_OVERRIDES; do
            if [ "${sg_ds_o%%=*}" = "$sg_ds_m" ]; then
                sg_ds_c=${sg_ds_o#*=}
                sg_ds_new="$sg_ds_new $sg_ds_m=${sg_ds_c%%=*}=$sg_ds_d"
                sg_ds_found=1
            else
                sg_ds_new="$sg_ds_new $sg_ds_o"
            fi
        done
        [ "$sg_ds_found" -eq 1 ] || sg_ds_new="$sg_ds_new $sg_ds_m=expensive=$sg_ds_d"
        SG_MOUNT_OVERRIDES=$sg_ds_new
    done
}
if [ "${WALK_BLOCKER_DEPTH_BY_MOUNT+set}" = set ]; then
    sg_colon_to_space "$WALK_BLOCKER_DEPTH_BY_MOUNT"
    sg_depth_seam "$sg_c2s"
else
    SG_MOUNT_OVERRIDES=$SG_MOUNT_OVERRIDES_TRUSTED
fi

SG_MOUNTS=${WALK_BLOCKER_MOUNTS:-$SG_MOUNTS_TRUSTED}   # the override is a test seam
SG_AUDIT=${WALK_BLOCKER_AUDIT:-}
# Absolute, and NOT env seams: the audit sink must not resolve through the
# environment it is auditing, and neither may the escaper, the identity or
# the clock that stamp the record. `[trusted_binaries]` in site.toml.
SG_LOGGER='@@LOGGER@@'
SG_AWK='@@AWK@@'
SG_ID='@@ID@@'
SG_DATE='@@DATE@@'

sg_always=0
sg_diract=''
sg_rec=''
sg_recval=''
sg_defdepth=''
sg_depthrec=0
sg_depthrange=0
sg_digitchars=''
sg_ttyfallback=0
sg_depth=''
# Every per-profile variable gets a default here, because POSIX sh has no
# local scope and an unset one would carry the previous tool's value.
sg_outdepth=''
sg_devflags=''
sg_devoff=''
sg_value=''
sg_cluster=''
sg_pat=''
sg_exact=''
sg_abbrev=0
sg_execflags=''
sg_execplus=''
sg_rootflags=''
sg_cwdflags=''
sg_skip=0
sg_mode=positional
sg_dashdash=predicate
sg_default='.'

case "$sg_tool" in
@@CASES@@    *)
        # Not a tool this table knows. Nothing to say about it.
        sg_mode=none
        ;;
esac

# --- resolve the real binary ------------------------------------------------
# Sets sg_real without forking: a command substitution here would cost a
# subshell on the fast path, which is the one path that must stay free.
sg_resolve() {
    sg_real=''
    sg_oifs=$IFS
    IFS=:
    for sg_d in $PATH; do
        [ -n "$sg_d" ] || sg_d=.
        # Never resolve back into ourselves: the compiled install directory
        # is skipped whatever the environment says, and WALK_BLOCKER_SHIM_DIR
        # -- a test seam, so the suite can run the shim out of a scratch
        # directory -- names one more.
        if [ -n "$WALK_BLOCKER_SHIM_DIR" ] && [ "$sg_d" = "$WALK_BLOCKER_SHIM_DIR" ]; then
            continue
        fi
        [ "$sg_d" = "$SG_BIN_DIR" ] && continue
        if [ -x "$sg_d/$sg_tool" ] && [ ! -d "$sg_d/$sg_tool" ]; then
            sg_real=$sg_d/$sg_tool
            break
        fi
    done
    IFS=$sg_oifs
    [ -n "$sg_real" ]
}

sg_audit_emit() {
    # sg_audit_emit ACTION SEAM ROOT MOUNT FS REASON RESOLVED SHADOW_RESOLVED
    #
    # Shared by the audited escape hatch (WALK_BLOCKER_UNSCOPED, SEAM empty)
    # and the two unaudited-seam checks below (WALK_BLOCKER_MOUNTS,
    # WALK_BLOCKER_SHIM_DIR). ROOT/MOUNT/FS/REASON describe a mount judgement --
    # the real one for the escape hatch, a SHADOW one (what the real mount
    # table would have said) for the mounts seam, empty for the dir seam.
    # RESOLVED/SHADOW_RESOLVED describe a binary resolution, used only by the
    # dir seam. All eight are always passed so one record shape and one pair
    # of sinks serve every caller; a field that does not apply to a given
    # caller is simply empty.
    #
    # Not on the fast path: every caller has already decided there is
    # something to say, which is the rare branch in each of the three cases
    # this serves.
    sg_ae_action=$1
    sg_ae_seam=$2
    sg_ae_root=$3
    sg_ae_mount=$4
    sg_ae_fs=$5
    sg_ae_reason=$6
    sg_ae_resolved=$7
    sg_ae_shadow=$8

    # journald, not just a file. $SG_AUDIT, when set, lives under the site's
    # spool directory, which is root-owned and not user-writable because the
    # root-run reaper writes there -- so an append made as the monitored user
    # could never create the file, and its failure was swallowed by the
    # 2>/dev/null. Every override by every ordinary user went unrecorded while
    # the refusal text promised otherwise, and the escape-hatch column of the
    # evidence for promoting the reaper to --kill would have read as a flat
    # zero.
    #
    # logger(1) is the sink that works for an unprivileged writer: /dev/log
    # accepts everyone, no user can truncate or edit what is already there, and
    # rotation is journald's problem rather than a logrotate snippet this repo
    # would have to ship and keep correct. Whether the journal persists across
    # a reboot is a property of the node's journald configuration; the
    # installer reports it.
    #
    # FOUR forks by now, not one: $SG_DATE, id, awk and logger. Worth stating
    # accurately, because this path's cost is the thing anyone analysing it
    # starts from -- and it is still the right trade, since every caller of
    # this function is already off the fast path. The FAST path is what must
    # stay fork-free, and it is: that is the whole argument for sh over
    # Python, and there is a test asserting no command substitution appears
    # in the region marked "# --- fast path" below, which this function is
    # not part of.
    # $SG_DATE, not `date`: through the caller's PATH a shadowed date wrote
    # any timestamp it liked into the record while the journal write still
    # succeeded, making the file sink's chronology forgeable by the very
    # account being audited. Same fix as SG_LOGGER/SG_AWK/SG_ID, and the
    # fourth place this layer had to stop trusting PATH.
    sg_when=$("$SG_DATE" -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)

    # Every field is escaped, and awk builds the record rather than printf.
    # These values are argv, environment and PATH: a path may legally contain
    # a quote, a backslash or a NEWLINE, and $PWD is whatever the caller says
    # it is. Interpolating them raw produced records that do not parse -- and
    # worse, a root of the form
    #   x","user":"someone-else
    # forges fields in a log that is meant to be shown to the person whose
    # process is in it. A split record also breaks the one-JSON-object-per-line
    # contract the reaper's own audit file keeps.
    #
    # awk, because POSIX sh has no substring replacement and this needs three
    # substitutions per field. Passed through the environment rather than argv
    # so nothing has to survive a second round of quoting. awk is a trusted
    # binary the site names, already relied on by the mount reader, and none
    # of this function's callers are on the fast path.
    # Identity from id(1), never from $USER. `USER=someone-else` filed the
    # override under another account, and an audit trail that accepts its
    # subject's own claim about who they are is not evidence. journald's own
    # `_UID`, stamped from the socket credentials, remains the authoritative
    # cross-check; this is the in-record copy so the file sink carries one too.
    sg_idbin=$SG_ID
    [ -x "$sg_idbin" ] || sg_idbin=$(command -v id 2>/dev/null)
    sg_uid=''
    [ -n "$sg_idbin" ] && sg_uid=$("$sg_idbin" -u 2>/dev/null)
    case "$sg_uid" in
        ''|*[!0-9]*) sg_uid=-1 ;;   # emitted as a bare JSON number, so verify
    esac

    sg_awk=$SG_AWK
    [ -x "$sg_awk" ] || sg_awk=$(command -v awk 2>/dev/null)
    sg_line=''
    [ -n "$sg_awk" ] && sg_line=$(
        SG_J_TS=$sg_when SG_J_ACTION=$sg_ae_action SG_J_SEAM=$sg_ae_seam \
        SG_J_TOOL=$sg_tool SG_J_ROOT=$sg_ae_root \
        SG_J_MOUNT=$sg_ae_mount SG_J_FS=$sg_ae_fs SG_J_REASON=$sg_ae_reason \
        SG_J_RESOLVED=$sg_ae_resolved SG_J_SHADOW=$sg_ae_shadow \
        SG_J_UID=$sg_uid SG_J_PWD=$PWD \
        "$sg_awk" 'function q(s) {
                 gsub(/\\/, "\\\\", s)
                 gsub(/"/, "\\\"", s)
                 gsub(/\n/, "\\n", s)
                 gsub(/\t/, "\\t", s)
                 gsub(/\r/, "\\r", s)
                 # Any other control character would still be a raw byte in a
                 # JSON string, which is invalid. Nothing is lost by naming it.
                 gsub(/[\001-\037]/, "?", s)
                 return "\"" s "\""
             }
             BEGIN {
                 printf "{\"ts\":%s,\"layer\":\"shim\"", q(ENVIRON["SG_J_TS"])
                 printf ",\"action\":%s", q(ENVIRON["SG_J_ACTION"])
                 printf ",\"seam\":%s,\"tool\":%s", q(ENVIRON["SG_J_SEAM"]), q(ENVIRON["SG_J_TOOL"])
                 printf ",\"root\":%s", q(ENVIRON["SG_J_ROOT"])
                 printf ",\"mount\":%s", q(ENVIRON["SG_J_MOUNT"])
                 printf ",\"fs\":%s", q(ENVIRON["SG_J_FS"])
                 printf ",\"reason\":%s", q(ENVIRON["SG_J_REASON"])
                 printf ",\"resolved\":%s", q(ENVIRON["SG_J_RESOLVED"])
                 printf ",\"shadow_resolved\":%s", q(ENVIRON["SG_J_SHADOW"])
                 # A bare number, not a string: sanitized to an
                 # integer above, so it needs no quoting.
                 printf ",\"uid\":%s", ENVIRON["SG_J_UID"]
                 printf ",\"pwd\":%s}", q(ENVIRON["SG_J_PWD"])
             }'
    )

    if [ -z "$sg_line" ]; then
        # No awk anywhere, so there is no safe way to put a caller-controlled
        # string into JSON. Emit the fields this shim controls -- action and
        # seam are literals from this file, the tool name is one of the
        # wrapped names, the fstype comes from the mount table -- and say what
        # was dropped. Losing the record entirely is the failure this sink
        # exists to fix, and interpolating raw bytes is the one it just
        # stopped doing.
        sg_line=$(printf '{"ts":"%s","layer":"shim","action":"%s","seam":"%s","tool":"%s","fs":"%s","reason":"%s","uid":%s,"note":"caller-controlled fields omitted: no awk to escape them"}' \
            "$sg_when" "$sg_ae_action" "$sg_ae_seam" "$sg_tool" "$sg_ae_fs" \
            "$sg_ae_reason" "$sg_uid")
    fi

    # An absolute path, not a PATH lookup. `command -v logger` resolved through
    # the caller's own PATH, so the monitored user could put a no-op `logger`
    # in front of /usr/bin/logger and the override would go unrecorded while
    # the shim exited 0 -- demonstrated. The audit sink must not depend on the
    # environment it is auditing. The PATH fallback is kept only for a host
    # that puts logger somewhere else, and is reached solely when the trusted
    # path is absent.
    if [ -x "$SG_LOGGER" ]; then
        "$SG_LOGGER" -t walk-blocker -p user.notice -- "$sg_line" 2>/dev/null
    elif command -v logger >/dev/null 2>&1; then
        logger -t walk-blocker -p user.notice -- "$sg_line" 2>/dev/null
    fi

    # The file sink stays for a root caller and as the seam the tests drive
    # through WALK_BLOCKER_AUDIT. It is the fallback now, not the record.
    #
    # The stderr redirect is on the OUTSIDE of a group, not on the printf.
    # Redirections apply left to right, so `>> "$SG_AUDIT" 2>/dev/null` opens
    # the file FIRST and reports "Permission denied" to a stderr that is still
    # the terminal -- and since the installed bashrc block exports
    # WALK_BLOCKER_AUDIT to every login shell, every ordinary user's override
    # printed that line.
    if [ -n "$SG_AUDIT" ]; then
        { printf '%s\n' "$sg_line" >> "$SG_AUDIT"; } 2>/dev/null
    fi
}

sg_exec_real() {
    if sg_resolve; then
        if [ -n "$WALK_BLOCKER_SHIM_DIR" ]; then
            # Cheap on every allowed invocation: pure parameter expansion, no
            # fork. The installer always sets this to the directory $0 itself
            # resolved through, so a mismatch is never the legitimate case --
            # only then is the (forking) shadow resolve below worth paying
            # for. This is the SECOND, narrower env-var seam ADR-0001 names:
            # WALK_BLOCKER_SHIM_DIR only changes which directory sg_resolve
            # skips, and the SG_BIN_DIR test above already blocks the
            # dangerous case independent of this var -- but a caller can still
            # point it at some OTHER directory and change which real binary
            # gets run, silently, same shape as the mounts seam below.
            sg_selfdir=${0%/*}
            [ "$sg_selfdir" != "$0" ] || sg_selfdir=.
            if [ "$WALK_BLOCKER_SHIM_DIR" != "$sg_selfdir" ]; then
                sg_shadow_real=$(
                    unset WALK_BLOCKER_SHIM_DIR
                    sg_resolve >/dev/null 2>&1
                    printf '%s' "$sg_real"
                )
                if [ "$sg_shadow_real" != "$sg_real" ]; then
                    sg_audit_emit unaudited_seam WALK_BLOCKER_SHIM_DIR \
                        '' '' '' '' "$sg_real" "$sg_shadow_real"
                fi
            fi
        fi
        exec "$sg_real" "$@"
    fi
    printf '%s: not found behind the walk-blocker shim\n' "$sg_tool" >&2
    exit 127
}
# --- fork-free helpers ------------------------------------------------------
# Everything from here to the fast-path marker is called BEFORE sg_exec_real
# and must fork nothing. It is a separate region from the fast path only
# because sh has no nested scopes: these are the callees, the fast path is
# their caller, and a fork costs the same wherever it is written.
#
# The region opens at sg_exec_real's closing brace rather than at the first
# helper, so a helper added into the gap later is inside it by default. That
# is the defect this marker exists to close: the check used to start at the
# fast path, so the digit scan's CALL SITES were checked and the functions
# doing the scanning were not -- a fork in sg_apply_depth's body passed.
#
# sg_exec_real itself is deliberately OUTSIDE. It forks, and it is allowed to:
# it runs after the decision, and the rule is that nothing before it forks.

sg_in() {
    # sg_in NEEDLE "haystack list". The needle is expanded inside a quoted
    # section of the case pattern, so glob characters in someone's argv stay
    # literal rather than matching everything.
    #
    # An EMPTY needle is never a member, and saying so here is the whole
    # point. Both sides are padded before matching, so an empty needle
    # and an empty HAYSTACK match each other -- `" "` contains `" "`. A
    # non-empty list was never at risk, which is why the fstype list and
    # every populated flag list behaved.
    #
    # The arm it reached, measured rather than assumed: `sg_execflags` is
    # empty for grep, rgrep, rg, tree, du and fzf, so the empty token matched
    # THAT first and set sg_r_exec, swallowing every REMAINING token as an
    # exec body -- not one token, and not the root-flag arm. `tree "" a b
    # /scratch` from a cheap cwd was ALLOWED on main, which only the
    # everything-swallowed reading explains: nroots stayed 0 and the cwd
    # fallback fired. fd reaches the pattern-flag arm instead (its exec list
    # is populated, its pattern list is not); find and bfs were never
    # affected, because leading mode returns before these arms.
    #
    # Guarded here rather than by skipping empty elements in the operand
    # loop, which was the issue's own suggestion and is wrong: an empty
    # element is never a FLAG but is a perfectly good POSITIONAL.
    # `grep -r "" /scratch` has an empty PATTERN -- it matches every line --
    # and dropping it would promote /scratch into the pattern slot and lose
    # the root a second way. What an empty POSITIONAL means is settled in
    # sg_judge(), not here.
    [ -n "$1" ] || return 1
    case " $2 " in
        *" $1 "*) return 0 ;;
    esac
    return 1
}

sg_val_in() {
    # sg_val_in VALUE "v1,v2,...". A rec-value flag can have more than ONE
    # on-value -- ugrep's -d takes `recurse` and `dereference-recurse` alike --
    # so every comparison against a $sg_recval entry is membership, not
    # equality. Listing the flag twice in $sg_recval would not work: all three
    # loops that read it `break` on the first token whose FLAG matches, so the
    # second token is unreachable and the second value would read as "skip".
    #
    # No forks, like everything before sg_exec_real: the list is walked with
    # parameter expansion, the same idiom as sg_colon_to_space. An empty VALUE
    # is never a member, matching sg_in.
    [ -n "$1" ] || return 1
    sg_vi_rest=$2
    while [ -n "$sg_vi_rest" ]; do
        [ "$1" = "${sg_vi_rest%%,*}" ] && return 0
        case "$sg_vi_rest" in
            *,*) sg_vi_rest=${sg_vi_rest#*,} ;;
            *) sg_vi_rest='' ;;
        esac
    done
    return 1
}

sg_apply_depth() {
    # Fold ONE depth occurrence -- MIN (may be empty) and MAX -- into
    # sg_lastdepth, or set sg_malformed. The shell twin of _apply_depth().
    #
    # ugrep's repeats are not last-wins: measured on 7.8.4, `--depth=1
    # --depth=5` walks 1..5, `--depth=1 --depth=3 --depth=5` walks 1..5, and
    # `--depth=5 --depth=1` is rejected outright and walks nothing. The rule
    # covering every measured case is that the LAST value is the MAX and the
    # FIRST is the MIN, and a MAX below that MIN is an error.
    #
    # Measured on 7.8.4 over a NINE-level tree, stdout and stderr separated:
    #
    #   --depth=1 --depth=5           walks 1..5
    #   --depth=5 --depth=1           `invalid argument -1`, walks nothing
    #   --depth=3,5 --depth=4         walks 3..4  -- VALID, not an error
    #   --depth=,9 --depth=5          `invalid argument -5`
    #   -3-5-7                        walks 3..7
    #
    # So the floor a later occurrence may not fall below is the MIN when the
    # first expression carries one, and the value itself when it does not.
    # Both halves measured; neither inferred from the other.
    #
    # An earlier version of this branch took the last value and called the
    # result right either way. It is not: that holds only while the smaller
    # value is within SG_MAXDEPTH. `--depth=9 --depth=5` errors and walks
    # nothing, while last-wins read it as a bound of 5 -- still above the
    # ceiling, and REFUSED. A false refusal on an argv the tool was going to
    # reject on its own is what teaches people to alias around this layer.
    #
    # Every malformed exit also CLEARS the value, so two argvs the tool
    # rejects identically cannot disagree about whether this is a traversal.
    case "$2" in
        ''|*[!0-9]*) sg_malformed=1; sg_lastdepth=''; return 0 ;;
    esac
    case "$1" in
        '') ;;
        *[!0-9]*) sg_malformed=1; sg_lastdepth=''; return 0 ;;
        *)
            if [ "$1" -gt "$2" ]; then
                sg_malformed=1
                sg_lastdepth=''
                return 0
            fi
            ;;
    esac
    if [ "$sg_depthrange" -eq 0 ]; then
        # Every other tool here really is last-wins -- `find -maxdepth 9
        # -maxdepth 1` walks one level, measured. Only a tool
        # whose repeats form a RANGE gets the floor below.
        sg_lastdepth=$2
        return 0
    fi
    if [ -z "$sg_floor" ]; then
        if [ -n "$1" ]; then sg_floor=$1; else sg_floor=$2; fi
    elif [ "$2" -lt "$sg_floor" ]; then
        sg_malformed=1
        sg_lastdepth=''
        return 0
    fi
    sg_lastdepth=$2
}

sg_take_depth() {
    # One depth-flag ARGUMENT, split into MIN and MAX and applied.
    #
    # Without sg_depthrange the whole value is the bound and there is no MIN.
    # With it the value is `[MIN,]MAX`. Measured on ugrep 7.8.4: `--depth=3,5`
    # and `--depth=,5` walk five levels; `--depth=2,` and `--depth=5,3` are
    # both rejected and walk nothing -- an absent MIN is fine, an absent MAX
    # is not, and a MIN above the MAX is refused rather than clamped.
    if [ "$sg_depthrange" -eq 1 ]; then
        case "$1" in
            *,*)
                # A second comma lands in MAX as a non-digit and is refused,
                # matching _depth_span()'s partition-on-the-first.
                sg_apply_depth "${1%%,*}" "${1#*,}"
                return 0
                ;;
        esac
    fi
    sg_apply_depth '' "$1"
}

sg_take_digits() {
    # One depth expression out of a short cluster: N, N-M, N,M, or the
    # truncated N- / N, that the tool rejects. `-` is the short separator and
    # `,` the long one.
    [ -n "$1" ] || return 0
    # A lone 0 is `--null`, not a depth -- only the BARE spelling; `0-3`
    # really does carry a MAX.
    [ "$1" = 0 ] && return 0
    case "$1" in
        *-*) sg_apply_depth "${1%%-*}" "${1#*-}" ;;
        *,*) sg_apply_depth "${1%%,*}" "${1#*,}" ;;
        *) sg_apply_depth '' "$1" ;;
    esac
}

# Split a `-abc` token the way getopt does: scanning left to right, the first
# letter that takes an argument consumes the rest of the token as its value, or
# the next argv element if the token ends there. So `-nefoo` is `-n` plus
# `-e foo` -- the f and o are not options -- and `-dread` is `-d read`, not a
# cluster containing r.
#
# If NO letter is a value flag, the whole token is a cluster of boolean
# switches -- and if $sg_cluster is set, every one of those letters has to be
# a member or the token is not a cluster at all: sg_cl_letters comes back
# empty, same as `--foo` or a bare `-`. Without that gate, a long predicate
# that happens to start with letters this tool never uses as flags --
# `-regextype` -- gets walked letter by letter like a real cluster, and any
# one of its letters that is also a device flag reads as though the caller
# had typed it. Measured: adding `-x` to find/bfs's device flags without this
# gate made every `bfs -regextype ... /` read as device-bounded.
#
# Parameter expansion only, no command substitution: this runs on the FAST
# path, and a subshell there is the one cost this shim exists to avoid. An
# earlier version used `$(printf ... | cut -c1-2)` and put two forks on it.
# The flag in $2 that $1 is an unambiguous long-option abbreviation of.
# GNU getopt_long takes any unique prefix, so `grep --rec pat /home` and
# `grep --dir=recurse pat /home` both recurse -- verified against grep(1),
# which accepts from `--di` up and calls `--d` ambiguous. Applied only to the
# traversal and pattern flag lists, and to the value list by the traversal
# and root scans. $sg_exact holds the tool's real non-consuming options that
# are a prefix of one of its value flags -- `--binary` for grep, `--time` for
# du -- which getopt_long matches exactly and so never treats as
# abbreviations. Without it, `grep --binary -r needle DIR` had the -r skipped
# as --binary-files' value and recursed unseen.
sg_resolve_long() {
    # Gated on sg_abbrev: only GNU getopt_long accepts a unique prefix.
    # find has its own predicate parser, rg and fd are clap, tree and fzf
    # reject prefixes -- modelling the grammar for them refused commands
    # those tools would themselves reject. Measured on the tools.
    [ "${sg_abbrev:-0}" -eq 1 ] || return 1
    # The caller only needs the yes/no; the matched flag itself is unused
    # here, unlike the Python side which returns it.
    case "$1" in
        --??*) ;;
        *) return 1 ;;
    esac
    # $sg_exact is read from the profile rather than passed in, so a new call
    # site cannot forget it. One did: the root scan's arm below was added
    # without it and immediately reintroduced the `du --time` false refusal
    # this list exists to prevent.
    for sg_rl_e in $sg_exact; do
        [ "$sg_rl_e" = "$1" ] && return 1
    done
    sg_rl_n=0
    for sg_rl_f in $2; do
        case "$sg_rl_f" in
            "$1"*)
                case "$sg_rl_f" in
                    --*) sg_rl_n=$((sg_rl_n + 1)) ;;
                esac
                ;;
        esac
    done
    [ "$sg_rl_n" -eq 1 ]
}

sg_cl_letters=''
sg_cl_vflag=''
sg_cl_glued=''
sg_cl_next=0
sg_parse_cluster() {
    sg_cl_letters=''
    sg_cl_vflag=''
    sg_cl_glued=''
    sg_cl_next=0
    case "$1" in
        --*|-) return 1 ;;
        -?*) ;;
        *) return 1 ;;
    esac
    sg_cl_rest=${1#-}
    while [ -n "$sg_cl_rest" ]; do
        sg_cl_l=${sg_cl_rest%"${sg_cl_rest#?}"}
        sg_cl_rest=${sg_cl_rest#?}
        sg_cl_letters=$sg_cl_letters$sg_cl_l
        if sg_in "-$sg_cl_l" "$sg_value"; then
            sg_cl_vflag=-$sg_cl_l
            if [ -n "$sg_cl_rest" ]; then
                sg_cl_glued=$sg_cl_rest
            else
                sg_cl_next=1
            fi
            return 0
        fi
    done
    if [ -n "$sg_cluster" ]; then
        sg_cl_check=$sg_cl_letters
        while [ -n "$sg_cl_check" ]; do
            sg_cl_c=${sg_cl_check%"${sg_cl_check#?}"}
            sg_cl_check=${sg_cl_check#?}
            case "$sg_cluster" in
                *"$sg_cl_c"*) ;;
                *) sg_cl_letters=''; return 1 ;;
            esac
        done
    fi
    return 0
}

if [ "$sg_mode" = none ]; then
    sg_exec_real "$@"
fi

# --- end fork-free helpers --------------------------------------------------
# --- fast path --------------------------------------------------------------
# A tool that only traverses when told to, and was not told to, is none of our
# business. Decided before any file is opened.
if [ "$sg_always" -eq 0 ]; then
    # LAST-WINS, not first-wins. GNU grep's directory handling is an ACTION
    # and -r is one of its settings, so a later `-d skip` undoes an earlier
    # -r. Measured on GNU grep:
    #   grep -r -d skip          no output   (does not descend)
    #   grep -d recurse -d skip  no output
    #   grep -d skip -r          descends
    #   grep -rd skip            no output   (cluster: -r then -d skip)
    #   rgrep -d skip            no output   (rgrep is grep -r, and honours it)
    # Breaking on the first -r refused commands that walk nothing, which on an
    # advisory layer is the failure that teaches people to alias around it.
    #
    # Tools with no directory action ($sg_diract empty) are unaffected: with
    # nothing that turns traversal back off, last-wins and first-wins agree.
    sg_action=$sg_diract
    sg_pending=0
    sg_pendrec=''
    for sg_a in "$@"; do
        if [ "$sg_pending" -eq 1 ]; then
            # The value of a flag -- but for a few flags the VALUE is the
            # action. `grep -d recurse` is `-r` spelled as an action, and
            # `-d skip` is its opposite, so both directions are set here.
            sg_pending=0
            if [ -n "$sg_pendrec" ]; then
                if sg_val_in "$sg_a" "$sg_pendrec"; then
                    sg_action=recurse
                else
                    sg_action=skip
                fi
            fi
            sg_pendrec=''
            continue
        fi

        # `--` ends the options. After it a flag-shaped token is a pattern:
        # `grep -- -r file` searches for the string -r and walks nothing.
        [ "$sg_a" = '--' ] && break

        case "$sg_a" in
            --*)
                # An exact attached rec-value spelling: --directories=recurse
                # sets recurse, --directories=skip sets skip.
                sg_hit=0
                for sg_rv in $sg_recval; do
                    sg_rvf=${sg_rv%%=*}
                    case "$sg_a" in
                        "$sg_rvf"=*)
                            if sg_val_in "${sg_a#*=}" "${sg_rv#*=}"; then
                                sg_action=recurse
                            else
                                sg_action=skip
                            fi
                            sg_hit=1
                            ;;
                    esac
                    [ "$sg_hit" -eq 1 ] && break
                done
                [ "$sg_hit" -eq 1 ] && continue

                if sg_in "$sg_a" "$sg_rec"; then
                    sg_action=recurse
                    continue
                fi
                if sg_resolve_long "$sg_a" "$sg_rec"; then
                    sg_action=recurse
                    continue
                fi
                # Abbreviated rec-value spellings: --dir=skip, --di skip.
                sg_head=${sg_a%%=*}
                for sg_rv in $sg_recval; do
                    sg_rvf=${sg_rv%%=*}
                    sg_rvv=${sg_rv#*=}
                    if sg_resolve_long "$sg_head" "$sg_rvf"; then
                        case "$sg_a" in
                            *=*)
                                if sg_val_in "${sg_a#*=}" "$sg_rvv"; then
                                    sg_action=recurse
                                else
                                    sg_action=skip
                                fi
                                ;;
                            *)
                                sg_pending=1
                                sg_pendrec=$sg_rvv
                                ;;
                        esac
                        sg_hit=1
                        break
                    fi
                done
                [ "$sg_hit" -eq 1 ] && continue
                sg_attached=0
                for sg_f in $sg_pat; do
                    case "$sg_a" in
                        "$sg_f"=*) sg_attached=1; break ;;
                    esac
                done
                [ "$sg_attached" -eq 1 ] && continue
                # An ABBREVIATED value flag consumes its value too, and
                # missing that is not the safe direction: `grep --rege -- -r
                # /home` has --rege eat the `--`, leaving -r live, and grep(1)
                # descends -- while this scan read the `--` as the marker and
                # reported no traversal.
                if sg_resolve_long "${sg_a%%=*}" "$sg_value"; then
                    case "$sg_a" in
                        *=*) ;;
                        *) sg_pending=1 ;;
                    esac
                    continue
                fi
                if sg_in "$sg_a" "$sg_value"; then
                    sg_pending=1
                    sg_pendrec=''
                    for sg_rv in $sg_recval; do
                        [ "${sg_rv%%=*}" = "$sg_a" ] && sg_pendrec=${sg_rv#*=}
                    done
                fi
                continue
                ;;
        esac

        # Short forms: one getopt-accurate split, replacing three special
        # cases that each missed a spelling a round apart.
        if sg_parse_cluster "$sg_a"; then
            sg_scan=$sg_cl_letters
            if [ -n "$sg_cl_vflag" ]; then
                sg_isdir=0
                for sg_rv in $sg_recval; do
                    [ "${sg_rv%%=*}" = "$sg_cl_vflag" ] || continue
                    sg_isdir=1
                    # WITHIN the token, left to right: `-rd skip` is -r then
                    # -d skip, so the -d wins. parse_short_cluster stops at
                    # the first value-taking letter, so that letter is last.
                    sg_scan=${sg_cl_letters%?}
                    if [ -n "$sg_cl_glued" ]; then
                        if sg_val_in "$sg_cl_glued" "${sg_rv#*=}"; then
                            sg_dirset=recurse
                        else
                            sg_dirset=skip
                        fi
                    elif [ "$sg_cl_next" -eq 1 ]; then
                        sg_pending=1
                        sg_pendrec=${sg_rv#*=}
                        sg_dirset=''
                    fi
                    break
                done
                # A value flag with nothing glued takes the NEXT element, so
                # skip it -- unless it is one whose value we are watching for.
                if [ "$sg_cl_next" -eq 1 ] && [ -z "$sg_pendrec" ]; then
                    sg_pending=1
                fi
            fi
            # Only the real OPTION letters -- never a glued value. This is why
            # `-dread` and `-nefoo` do not read as recursive, while `-rIn` and
            # `-rhoE` still do.
            case "$sg_scan" in
                *[rR]*) sg_action=recurse ;;
            esac
            # ...and the directory action, applied AFTER the letters before it.
            if [ "${sg_isdir:-0}" -eq 1 ] && [ -n "${sg_dirset:-}" ]; then
                sg_action=$sg_dirset
            fi
            sg_isdir=0
            sg_dirset=''
            continue
        fi

        if sg_in "$sg_a" "$sg_rec"; then
            sg_action=recurse
            continue
        fi
    done
    # "recurse_default" is a THIRD action, and it only ever arrives as this
    # tool's default: ugrep walks a directory operand because it is ugrep,
    # not because a flag said so. Traversal is either of the two; which one is
    # still in force is also what decides, below, whether sg_defdepth applies.
    # Two arms rather than `recurse|recurse_default`: this runs before
    # sg_exec_real, where the fast-path fork check reads a `|` as a pipeline.
    # Spelling it out costs a line and keeps that check's predicate simple,
    # which is worth more than the line.
    case "$sg_action" in
        recurse) ;;
        recurse_default) ;;
        *)
            # For ugrep a depth flag outranks the action and is NOT subject to
            # its last-wins -- measured on 7.8.4, `-d skip` alone walks
            # nothing while `-d skip --depth=9` and `--depth=9 -d skip` both
            # walk the whole tree. So "skip" is not final until the bounds
            # loop has run, and the decision is deferred rather than taken
            # here. Every other tool exits now, exactly as before.
            [ "$sg_depthrec" -eq 1 ] || sg_exec_real "$@"
            sg_action_skipped=1
            ;;
    esac
fi

# --- bounded? ---------------------------------------------------------------
# LAST depth flag wins, because that is what the tools do. Measured:
#   find sgp -maxdepth 1 -maxdepth 9 -name deep.txt   found the depth-6 file
#   find sgp -maxdepth 9 -maxdepth 1 -name deep.txt   (nothing)
#   du -d 1 -d 9 sgp   6 lines      du -d 9 -d 1 sgp   2 lines
#   tree -L 1 -L 4 sgp                                 4 directories
# Stopping at the FIRST one made `find /scratch -maxdepth 1 -maxdepth 9` read
# as bounded while find walks to depth 9. rg and fd reject a repeated depth
# flag outright, so for them either answer is moot.
#
# The same pass also reads the DEVICE bound -- `find -xdev`, `du -x`,
# `rg/fd --one-file-system`, `tree -x` -- because both facts have to step over
# the same grammar (exec bodies, `--`, a value flag's value, a cluster's glued
# value) and a second loop is a second place for one of those rules to go
# missing. It is not the same KIND of bound: a depth bound makes any walk
# cheap and exits here, while a device bound only stops the walk crossing ONTO
# an expensive filesystem, so it is applied per root in sg_judge.
sg_devbound=0
sg_lastdepth=''
# The floor a later depth occurrence may not fall below, for a tool whose
# repeats form a range rather than last-winning (sg_depthrange). Empty until
# the first expression sets it. See sg_apply_depth.
sg_floor=''
sg_malformed=0
sg_want_depth=0
sg_pending=0
sg_in_exec=0
sg_exec_plus=0
sg_exec_prev=''
for sg_a in "$@"; do
    # find's -exec/-execdir/-ok/-okdir body is DATA up to its `;` or `+`, so a
    # -maxdepth inside one is an argument to the command being run, not a
    # predicate. `+` terminates only the `-exec/-execdir ... {} +` form:
    # treating every `+` as one was itself a bypass, because in
    # `find /scratch -exec echo + -maxdepth 1 ';'` the `+` is echo's argument.
    if [ "$sg_in_exec" -eq 1 ]; then
        if [ "$sg_a" = ';' ]; then
            sg_in_exec=0
        elif [ "$sg_exec_plus" -eq 1 ] && [ "$sg_a" = '+' ] \
             && [ "$sg_exec_prev" = '{}' ]; then
            sg_in_exec=0
        else
            sg_exec_prev=$sg_a
        fi
        continue
    fi
    if [ "$sg_want_depth" -eq 1 ]; then
        sg_want_depth=0
        # find/tree validate this as they parse, before opening anything --
        # a missing or non-numeric value means the command errors out and
        # walks NOTHING, which is a stronger fact than "unbounded".
        # Validated HERE, immediately, so an earlier malformed
        # occurrence cannot be laundered by a later valid one.
        sg_take_depth "$sg_a"
        continue
    fi
    if [ "$sg_pending" -eq 1 ]; then
        # A flag's value, so a `--` sitting in it is not a marker.
        sg_pending=0
        continue
    fi
    # AFTER the two pending-value guards, not before them. A token that is
    # another flag's value is not an exec introducer, however much it looks
    # like one: `fd --exclude -x --max-depth 1 pat DIR` has -x as --exclude's
    # value, and testing this first started a template that swallowed the real
    # bound -- so the shim refused while the table allowed.
    if sg_in "$sg_a" "$sg_execflags"; then
        sg_in_exec=1
        sg_exec_prev=''
        if sg_in "$sg_a" "$sg_execplus"; then sg_exec_plus=1; else sg_exec_plus=0; fi
        continue
    fi
    if [ "$sg_a" = '--' ]; then
        # A depth flag after `--` is a pattern, not a bound. Any real bound
        # BEFORE it still counts, which is why this breaks to the decision
        # below rather than declaring the walk unbounded.
        #
        # find's grammar is the exception: `--` there precedes the path
        # OPERANDS and the predicates come after them and stay active, so
        # `find -- /scratch -maxdepth 1` really is bounded to one level.
        [ "$sg_mode" = leading ] && continue
        break
    fi
    if sg_in "$sg_a" "$sg_depth"; then
        sg_want_depth=1
        continue
    fi
    sg_v=''
    sg_v_matched=0
    for sg_f in $sg_depth; do
        case "$sg_a" in
            "$sg_f"=*) sg_v=${sg_a#*=}; sg_v_matched=1 ;;
        esac
        [ "$sg_v_matched" -eq 1 ] && break
    done
    if [ "$sg_v_matched" -eq 1 ]; then
        # Same validation as the separate-token form above, and for the same
        # reason: `--max-depth=` (empty) or `--max-depth=x` means find or du
        # rejects the argument and never opens anything.
        sg_take_depth "$sg_v"
        continue
    fi
    # `-d2`, `-L3`: a short depth flag with its value attached.
    sg_v=''
    sg_v_matched=0
    for sg_f in $sg_depth; do
        case "$sg_f" in
            -?) ;;
            *) continue ;;
        esac
        case "$sg_a" in
            "$sg_f"[0-9]*)
                sg_v_matched=1
                sg_v=${sg_a#??}
                case "$sg_v" in
                    ''|*[!0-9]*) sg_v='' ;;
                esac
                ;;
        esac
        [ "$sg_v_matched" -eq 1 ] && break
    done
    if [ "$sg_v_matched" -eq 1 ]; then
        # sg_v can be empty here even though the glued-digit SHAPE matched
        # (`-L2x`: a digit, then a non-digit) -- the shape promised a bound
        # and the tool rejects the value, the same "will not run" fact as
        # every other malformed site here.
        if [ -n "$sg_v" ]; then
            sg_take_depth "$sg_v"
        else
            sg_malformed=1
            sg_lastdepth=''
        fi
        continue
    fi
    # A device bound, in its exact or abbreviated long spelling. LAST-WINS:
    # rg's `--no-one-file-system` undoes an earlier `--one-file-system`, and
    # rg is the only wrapped tool with a spelling that turns it back off.
    #
    # The `-n` guards below predate the empty-needle rule, when sg_in's padding let an EMPTY
    # list and an EMPTY argument match each other and `find -xdev "" ...`
    # cleared the bound it had just set. sg_in now refuses an empty needle
    # outright, so they are belt to that braces -- kept because a list-empty
    # check at the call site reads as intent, not because it is load-bearing.
    if [ -n "$sg_devflags" ]; then
        if [ -n "$sg_devoff" ] && sg_in "$sg_a" "$sg_devoff"; then
            sg_devbound=0
            continue
        fi
        if sg_in "$sg_a" "$sg_devflags"; then
            sg_devbound=1
            continue
        fi
        if [ -n "$sg_devoff" ] && sg_resolve_long "$sg_a" "$sg_devoff"; then
            sg_devbound=0
            continue
        fi
        if sg_resolve_long "$sg_a" "$sg_devflags"; then
            sg_devbound=1
            continue
        fi
        # ...and inside a cluster: `du -sx /`, `tree -xL 2 /srv`. No `continue`
        # -- the same token can carry a depth bound as well (`du -xd1 /`), and
        # the cluster arm below is what reads that.
        if sg_parse_cluster "$sg_a"; then
            sg_dev_scan=$sg_cl_letters
            while [ -n "$sg_dev_scan" ]; do
                sg_dev_l=${sg_dev_scan%"${sg_dev_scan#?}"}
                sg_dev_scan=${sg_dev_scan#?}
                sg_in "-$sg_dev_l" "$sg_devflags" && sg_devbound=1
            done
        fi
    fi
    # ugrep spells a depth as a bare digit run, and it clusters with letters:
    # `-l9`, `-9l`, `-rl2`, and `-l10` which is TEN rather than `-1` then
    # `-0`. No `continue` -- the same token can still carry a value flag, and
    # the arm below has to step over it.
    if [ -n "$sg_digitchars" ] && sg_parse_cluster "$sg_a"; then
        # Scanned over the OPTION LETTERS and never over a glued value, which
        # is what keeps `-lC3` a depth-1 walk: sg_parse_cluster stops at the
        # first value-taking letter and hands its argument back as
        # sg_cl_glued, so the 3 is -C's context and is not here to be misread.
        #
        # The charset gate covers the other collision, the one $sg_value
        # cannot: -K, -m, -Z and -Q take OPTIONAL numeric arguments, so
        # listing them would make them eat a token they do not take (the
        # --color rule) and their digits arrive among the letters. A token
        # carrying any character outside the set is not scanned at all, so an
        # unaudited flag costs a bound rather than inventing one.
        sg_dg_ok=1
        sg_dg_scan=$sg_cl_letters
        while [ -n "$sg_dg_scan" ]; do
            sg_dg_c=${sg_dg_scan%"${sg_dg_scan#?}"}
            sg_dg_scan=${sg_dg_scan#?}
            case "$sg_digitchars" in
                *"$sg_dg_c"*) ;;
                *) sg_dg_ok=0; break ;;
            esac
        done
        if [ "$sg_dg_ok" -eq 1 ]; then
            # Each N, N-M or N,M in the residual is ONE depth occurrence,
            # handed to the same accumulator as the long spellings -- so
            # `-l9-3` is rejected for the same reason `--depth=9,3` is,
            # rather than quietly becoming a bound of 9. Taking the max of
            # the digit runs was that bug.
            #
            # The trailing sentinel flushes the last expression, so the flush
            # is written once instead of again after the loop.
            sg_dg_expr=''
            sg_dg_scan=$sg_cl_letters!
            while [ -n "$sg_dg_scan" ]; do
                sg_dg_c=${sg_dg_scan%"${sg_dg_scan#?}"}
                sg_dg_scan=${sg_dg_scan#?}
                case "$sg_dg_c" in
                    [0-9])
                        sg_dg_expr=$sg_dg_expr$sg_dg_c
                        continue
                        ;;
                    -|,)
                        # A separator continues the expression, but only once
                        # and only after a digit: `3-5` is one range, while
                        # `-l-3` has its leading dash flushed as nothing.
                        case "$sg_dg_expr" in
                            '') ;;
                            *[-,]*) ;;
                            *) sg_dg_expr=$sg_dg_expr$sg_dg_c; continue ;;
                        esac
                        ;;
                esac
                sg_take_digits "$sg_dg_expr"
                sg_dg_expr=''
            done
        fi
    fi
    # A value flag reached inside a cluster consumes the next element, so that
    # element is NOT a depth bound -- but a DEPTH flag inside a cluster still
    # is one: `du -hd1 /scratch` is `-h` plus `-d1`, a real depth-1 walk.
    if sg_parse_cluster "$sg_a" && [ -n "$sg_cl_vflag" ]; then
        if sg_in "$sg_cl_vflag" "$sg_depth"; then
            if [ -n "$sg_cl_glued" ]; then
                # Same validation as every other depth-value site here, and
                # the same reason: `tree -xL2x` and `tree -xL` (nothing
                # glued, nothing following either -- see the loop-end check
                # for that half) both mean tree rejects the level and walks
                # nothing.
                sg_take_depth "$sg_cl_glued"
            elif [ "$sg_cl_next" -eq 1 ]; then
                sg_want_depth=1
            fi
            continue
        fi
        [ "$sg_cl_next" -eq 1 ] && sg_pending=1
        continue
    fi
    # An ABBREVIATED value flag consumes its value here too: `du --time-s
    # --max-depth 1 DIR` has --time-style take `--max-depth` as its style
    # string, unvalidated, and du then walks DIR unbounded -- measured, four
    # levels deep. sg_resolve_long consults $sg_exact, so du's own `--time`
    # (an optional-argument option) is still not treated as an abbreviation
    # and a real bound after it survives. See bounded() in search_rules.py
    # for the counterexample that retired the objection to this.
    if sg_resolve_long "${sg_a%%=*}" "$sg_value"; then
        case "$sg_a" in
            *=*) ;;
            *) sg_pending=1 ;;
        esac
        continue
    fi
    if sg_in "$sg_a" "$sg_value"; then
        sg_pending=1
        continue
    fi
done
# The depth flag was the very last token in argv, so sg_want_depth is still
# set with nothing left to consume -- missing, not merely non-numeric, but
# the same "will not run" fact as every other malformed site above.
if [ "$sg_want_depth" -eq 1 ]; then
    sg_malformed=1
    sg_lastdepth=''
fi

# A depth flag with a missing or non-numeric value makes the tool exit
# before it opens anything -- find: "Expected a positive decimal integer
# argument to -maxdepth"; tree: "Missing argument to -L option" -- so ALLOW
# is correct regardless of what any root would otherwise judge to. Checked
# before the fast accept below because it is a stronger fact than any
# bound: this is not "no bound was given", it is "nothing will be walked at
# all".
[ "$sg_malformed" -eq 1 ] && sg_exec_real "$@"

# Fast accept, then remember the value. A bound within SG_MAXDEPTH is allowed
# on EVERY mount, so it exits here without reading /proc/mounts -- the early
# exit every currently-allowed bounded call already took. A LOOSER bound falls
# through with sg_depthval set, and sg_judge decides per mount. Non-numeric
# stays empty, i.e. unbounded, as it did when this set sg_bounded=0.
#
# NOT named sg_depth: that already holds this tool's depth FLAG LIST, set by
# the per-profile case arm, and the refusal text loops over it to print
# "Or bound the walk: -maxdepth 2". Reusing the name made every refusal print
# the parsed VALUE where the flag belongs -- "Or bound the walk: 4 2" -- and
# made every tool that has a depth flag report that it has none.
# The action said "skip" and only a depth flag could have overridden it. None
# did, so the deferred decision from the traversal gate resolves to "walks
# nothing". (A malformed one already exited just above, which is the same
# answer by a shorter route.)
if [ "${sg_action_skipped:-0}" -eq 1 ] && [ -z "$sg_lastdepth" ]; then
    sg_exec_real "$@"
fi

sg_depthval=''
case "$sg_lastdepth" in
    ''|*[!0-9]*) ;;
    *)
        sg_depthval=$sg_lastdepth
        [ "$sg_lastdepth" -le "$SG_MAXDEPTH" ] && sg_exec_real "$@"
        ;;
esac

# sg_defdepth is the depth this tool applies to a directory operand on its own
# -- ugrep's 1 -- and it is in force only while NOTHING has set the action,
# which is exactly what the third action value records. Kept separate from
# sg_expldepth, because the two are not interchangeable at the fallback below.
#
# Deliberately NOT fast-accepted, unlike an explicit bound. This ladder runs
# before the root scan, so it cannot yet know whether a FILE operand exists --
# and with none, ugrep's fallback is an implicit -R over the working directory
# and is UNBOUNDED rather than depth-1. Exiting here would apply the default to
# a walk that does not have it. The cost is that `ugrep pat file.txt` reaches
# sg_judge and pays one mount load; it is the only place a profile gives up the
# fast accept, and sg_judge allows a depth of 1 on every mount anyway.
sg_expldepth=$sg_depthval
if [ -z "$sg_depthval" ] && [ -n "$sg_defdepth" ] \
   && [ "$sg_action" = "$sg_diract" ]; then
    sg_depthval=$sg_defdepth
fi

# --- path handling ----------------------------------------------------------
sg_normpath() {
    # Absolute, normalized form of a path operand, as the shell would see it.
    # Fork-free: this runs once per root operand.
    sg_p=$1
    # A quoted ~ reaches the shim unexpanded, so expanding it here is the
    # point rather than an oversight -- hence the suppression.
    # shellcheck disable=SC2088
    case "$sg_p" in
        '~') sg_p=$HOME ;;
        '~/'*) sg_p=$HOME/${sg_p#'~/'} ;;
    esac
    case "$sg_p" in
        /*) ;;
        # $sg_base, not $PWD: fd's --base-directory replaces the directory
        # relative operands resolve against. Verified on the tool -- from a
        # scratch directory, `fd --base-directory BASE patfile sub` found
        # `sub/patfile`, which exists only under the base. sg_base defaults to
        # $PWD, so every other tool is unaffected.
        *) sg_p=${sg_base:-$PWD}/$sg_p ;;
    esac
    sg_out=''
    sg_oifs=$IFS
    IFS=/
    for sg_c in $sg_p; do
        case "$sg_c" in
            ''|.) continue ;;
            ..) sg_out=${sg_out%/*} ;;
            *) sg_out=$sg_out/$sg_c ;;
        esac
    done
    IFS=$sg_oifs
    sg_norm=${sg_out:-/}
}

sg_depth_below() {
    # Components of $1 below mount $2; -1 when $1 is not under $2.
    sg_db_path=$1
    sg_db_mount=${2%/}
    if [ -z "$sg_db_mount" ]; then
        sg_db_rest=$sg_db_path
    elif [ "$sg_db_path" = "$sg_db_mount" ]; then
        sg_below=0
        return 0
    else
        case "$sg_db_path" in
            "$sg_db_mount"/*) sg_db_rest=${sg_db_path#"$sg_db_mount"} ;;
            *) sg_below=-1; return 0 ;;
        esac
    fi
    sg_below=0
    sg_oifs=$IFS
    IFS=/
    for sg_c in $sg_db_rest; do
        [ -n "$sg_c" ] && sg_below=$((sg_below + 1))
    done
    IFS=$sg_oifs
}

# --- the expensive mounts, read ONCE ----------------------------------------
# sg_judge used to read and parse the whole of $SG_MOUNTS per ROOT OPERAND,
# and it returns early only on a refusal -- so the ALLOWED case, the one this
# guard exists to wave through, always paid full price, once per operand.
#
# That is not a small constant. A login node running containers carries a
# mount table of hundreds of overlay and squashfs rows with enormous option
# strings; measured at a reference deployment against a table of that shape,
# the per-operand re-read made `du -sh *` in a large directory a matter of
# seconds of pure shell before du started. A cost guard adding load in the
# case it means to allow, on a shared node with a latency-sensitive tenant,
# is the failure this whole layer is supposed to be preventing.
#
# Still LAZY rather than hoisted to the top of the script: the fast path and
# the bounded path both exit before this, and fzf reading a pipe judges no
# roots at all, so the read happens on the first sg_judge and not before.
#
# ONE fork, deliberately, and it is the difference between hundreds of
# milliseconds and single digits on a large table (measured at a reference
# deployment; the ratio, not the figure, is the argument): dash's `read`
# consumes a byte at a time so as not to over-read the fd, which is one
# read(2) per byte of the table, while awk parses the same bytes in one
# process. Hoisting the read out of the operand loop fixed the SCALING; the
# fork is what fixes the constant.
#
# The no-forks rule this repo states is about the FAST path -- the one that
# must not make `ps aux | grep sshd` measurably slower -- and that path exits
# long before here, with a test asserting it. This is the guarded path, which
# is already about to walk a filesystem.
#
# $SG_AWK is the absolute path, for the same reason the audit record uses it:
# resolving `awk` through the caller's PATH would let the audited user decide
# what parses the mount table. If it is absent the pure-sh reader below still
# answers. If it FAILS, that path is taken too -- an empty list would mean no
# expensive mounts and allow every walk, so a failure must not be mistaken
# for a clean answer.
#
# WHICH rows are expensive is classify_mount()'s decision (ADR-0016), made
# from the four /proc/mounts fields and the compiled site values alone -- no
# statfs, no measurement, nothing that can block on the filesystem being
# judged (ADR-0015). Both readers implement the same tiers, in the same
# order, and a test asserts they agree with the table branch by branch:
#
#   1. an exact SG_MOUNT_OVERRIDES entry for the mount point wins outright;
#   2. else a type matching any SG_FSTYPES glob is expensive;
#   3. else, with SG_PROXY, a `host:` source or a `_netdev` / `addr=` option
#      marks the mount remote, and remote-unknown is expensive;
#   4. else cheap.
#
# So an UNKNOWN REMOTE type is guarded the moment it appears in the live
# table, with no rebuild, while an unknown LOCAL type (tmpfs, an overlay, a
# loop mount) is cheap. A false refusal on a small remote export is a
# configuration omission, fixed by an override in `[[filesystems.mounts]]`,
# never by narrowing the type list.
sg_mounts_loaded=0
sg_expensive=''

sg_classify() {
    # sg_classify SOURCE MOUNTPOINT FSTYPE OPTIONS -- sets sg_class to
    # `expensive` or `cheap`. The sh twin of classify_mount(); the awk reader
    # below carries the same tiers inline. MOUNTPOINT arrives normalised.
    sg_class=''
    for sg_cl_o in $SG_MOUNT_OVERRIDES; do
        if [ "${sg_cl_o%%=*}" = "$2" ]; then
            sg_class=${sg_cl_o#*=}
            sg_class=${sg_class%%=*}
            return 0
        fi
    done
    for sg_cl_f in $SG_FSTYPES; do
        # A glob, matched as one: `fuse.*` covers every FUSE gateway. `case`
        # pattern matching is unaffected by `set -f`, which only turns off
        # pathname expansion.
        # shellcheck disable=SC2254
        case "$3" in
            $sg_cl_f) sg_class=expensive; return 0 ;;
        esac
    done
    if [ "$SG_PROXY" -eq 1 ]; then
        # `^[^/]+:` -- a source spelled host:path. The part before the first
        # colon must be non-empty and contain no slash, so `//srv/share` and
        # `/dev/sda1` are local and `srv:/export` is not.
        sg_cl_head=${1%%:*}
        if [ "$sg_cl_head" != "$1" ] && [ -n "$sg_cl_head" ]; then
            case "$sg_cl_head" in
                */*) ;;
                *) sg_class=expensive; return 0 ;;
            esac
        fi
        sg_cl_rest=$4
        while [ -n "$sg_cl_rest" ]; do
            sg_cl_one=${sg_cl_rest%%,*}
            case "$sg_cl_rest" in
                *,*) sg_cl_rest=${sg_cl_rest#*,} ;;
                *) sg_cl_rest='' ;;
            esac
            case "$sg_cl_one" in
                _netdev|addr=*) sg_class=expensive; return 0 ;;
            esac
        done
    fi
    sg_class=cheap
}

sg_load_mounts() {
    [ "$sg_mounts_loaded" -eq 1 ] && return 0
    sg_mounts_loaded=1
    if [ -x "$SG_AWK" ]; then
        # Same tiers as sg_classify above, and deliberately the same SHAPE:
        # skip a short line and an octal-escaped mount point, strip ONE
        # trailing slash, then override / type / proxy / cheap. A difference
        # between these two readers is a difference in one layer's own
        # answer, which is worse than the documented difference between the
        # layers below. The lists arrive through the environment, not `-v`:
        # awk's -v processes escape sequences, and the ERE list carries `\.`.
        sg_expensive=$(SG_R_RELIST=$SG_FSTYPES_RE SG_R_OVERRIDES=$SG_MOUNT_OVERRIDES \
            SG_R_PROXY=$SG_PROXY "$SG_AWK" '
            BEGIN {
                sg_nre = split(ENVIRON["SG_R_RELIST"], sg_re, " ")
                sg_novr = split(ENVIRON["SG_R_OVERRIDES"], sg_rows, " ")
                for (sg_i = 1; sg_i <= sg_novr; sg_i++) {
                    split(sg_rows[sg_i], sg_f, "=")
                    sg_ovr[sg_f[1]] = sg_f[2]
                }
                sg_proxy = ENVIRON["SG_R_PROXY"] + 0
            }
            NF >= 4 && $2 !~ /\\040|\\011/ {
                sg_m = $2
                sub(/\/$/, "", sg_m)
                if (sg_m == "") sg_m = "/"
                sg_c = ""
                if (sg_m in sg_ovr) {
                    sg_c = sg_ovr[sg_m]
                } else {
                    for (sg_i = 1; sg_i <= sg_nre; sg_i++) {
                        if ($3 ~ sg_re[sg_i]) { sg_c = "expensive"; break }
                    }
                    if (sg_c == "" && sg_proxy) {
                        if ($1 ~ /^[^\/]+:/) {
                            sg_c = "expensive"
                        } else {
                            sg_no = split($4, sg_o, ",")
                            for (sg_i = 1; sg_i <= sg_no; sg_i++) {
                                if (sg_o[sg_i] == "_netdev" || sg_o[sg_i] ~ /^addr=/) {
                                    sg_c = "expensive"; break
                                }
                            }
                        }
                    }
                }
                if (sg_c == "expensive") print sg_m ":" $3
            }' "$SG_MOUNTS" 2>/dev/null) && return 0
        sg_expensive=''
    fi
    # sg_rest is named only to make `read` split the line into the right
    # fields; /proc/mounts is source, mountpoint, fstype, options, then two
    # dump/pass numbers this reader never looks at.
    # shellcheck disable=SC2034
    while read -r sg_dev sg_mnt sg_fs sg_opts sg_rest; do
        # Fewer than four fields is not a mount-table row; the table skips
        # it too.
        [ -n "$sg_opts" ] || continue
        # /proc/mounts octal-escapes whitespace in the mount point and sh has
        # no substring replacement to undo it, so this layer SKIPS such a
        # mount.
        #
        # search_rules.py does NOT: it unescapes and keeps it. That is a real
        # difference between the two consumers, and it is recorded here rather
        # than claimed away. Layer 1 allows a walk of a mount point with a
        # space in it; Layer 2 reports it. That is the safe direction, the
        # same one bounded() sits on, and it is pinned by
        # test_the_shim_ignores_a_whitespace_escaped_mount_and_the_table_does_not.
        # A mount point with a space in it on a login node would be a
        # stranger event than the walk being guarded.
        #
        # It is also what makes the list below safe to word-split, which is
        # load-bearing rather than incidental.
        case "$sg_mnt" in
            *'\040'*|*'\011'*) continue ;;
        esac
        sg_mnt=${sg_mnt%/}
        [ -n "$sg_mnt" ] || sg_mnt=/
        sg_classify "$sg_dev" "$sg_mnt" "$sg_fs" "$sg_opts"
        [ "$sg_class" = expensive ] || continue
        sg_expensive="$sg_expensive $sg_mnt:$sg_fs"
    done < "$SG_MOUNTS"
    return 0
}

# Verdict slots, set once by the first offence found. sg_allow is the depth
# ceiling that applies to that offence, resolved by sg_judge and read by both
# the verdict and the refusal text; the default matters only if the message is
# ever reached without a judgement, which nothing does today.
sg_allow=$SG_MAXDEPTH
sg_reason=''
sg_hit_mount=''
sg_hit_fs=''
sg_hit_root=''

sg_allowance() {
    # sg_allowance MOUNT -- sets sg_allow to that mount's depth ceiling: the
    # MAXDEPTH column of its SG_MOUNT_OVERRIDES entry when it has one, else
    # SG_MAXDEPTH. The twin of depth_allowance(). A mount the table does not
    # mention is judged exactly as it was before the table existed.
    #
    # sg_al_o, not sg_pair: the callers are inside `for sg_pair in
    # $sg_expensive`, and per POSIX a function shares its caller's variables.
    sg_allow=$SG_MAXDEPTH
    for sg_al_o in $SG_MOUNT_OVERRIDES; do
        if [ "${sg_al_o%%=*}" = "$1" ]; then
            sg_al_c=${sg_al_o#*=}
            case "$sg_al_c" in
                *=*) sg_allow=${sg_al_c#*=} ;;
            esac
        fi
    done
    case "$sg_allow" in
        ''|*[!0-9]*) sg_allow=$SG_MAXDEPTH ;;
    esac
    # The build validated every compiled maxdepth against
    # depth_allowance_max, and sg_depth_seam dropped any live pair above it;
    # this is the belt to those braces, so that a fat-fingered `/home=999`
    # can never be MORE permissive than the global ceiling by any route.
    # Checked with `-gt` only after the digit case above, so this never
    # compares a non-numeric string.
    if [ "$sg_allow" -gt "$SG_DEPTH_ALLOWANCE_MAX" ]; then
        sg_allow=$SG_MAXDEPTH
    fi
}

sg_charge() {
    # sg_charge ROOT -- count a path operand, then judge it. Returns 0 only
    # when the walk is refused, so `sg_charge X && break` reads the way the
    # open-coded count-then-judge pair it replaces did.
    #
    # An EMPTY operand is not counted, and that is the whole subtlety. It
    # walks nothing, so it charges no root -- but leaving it OUT of sg_nroots
    # is what lets an invocation whose only operand is empty still reach the
    # cwd fallback, exactly as roots() does. Counting it and suppressing the
    # fallback was a BYPASS: the shim decides skip_pos streaming while the
    # table decides it after the whole scan, so for
    # `grep -r /scratch "" -e pat` the shim skipped /scratch as the pattern,
    # declined to judge the empty, and then declined the cwd too -- judging
    # nothing at all, and allowing a recursive grep of the parallel filesystem that
    # the table refused. See the note in roots().
    # A DRY pass counts and judges nothing. It exists only to discover whether
    # a pattern flag appears anywhere, which is what decides whether the first
    # positional is a path or the pattern. See sg_rootscan().
    [ "${sg_dry:-0}" -eq 1 ] && return 1
    # COUNTED before the empty check, not after. sg_nroots answers "did the
    # caller name an operand", which is a different question from "is there a
    # root to judge" -- an empty operand names something and walks nothing.
    # Counting it is what suppresses the cwd fallback, matching `named` in
    # roots(). Getting this backwards refused `tree ""` against an expensive cwd for
    # a command the tool segfaults on rather than walks.
    sg_nroots=$((sg_nroots + 1))
    [ -n "$1" ] || return 1
    sg_judge "$1"
}

sg_judge() {
    # sg_judge ROOT -- does walking ROOT enumerate an expensive mount?
    #
    # An EMPTY root enumerates nothing: it is a real argv element -- `find
    # "$dir"` with dir unset -- and no wrapped tool walks anything for it,
    # without that stopping the other operands. Measured on the tools, `find
    # real "" -name '*.txt'` still returns real's hits, and `du -sh real ""`
    # still prints real's total. Mirrors _drop_empty_operands() in the table.
    # Callers go through sg_charge(), which also keeps it out of sg_nroots;
    # this is the backstop for the one caller that does not.
    [ -n "$1" ] || return 1
    [ -n "$sg_reason" ] && return 0
    sg_raw=$1
    sg_normpath "$sg_raw"
    sg_path=$sg_norm

    sg_desc_sev=99
    sg_desc_len=99999
    sg_desc_mount=''
    sg_desc_fs=''
    # Empty, not SG_MAXDEPTH: "no descended mount seen yet" has to be
    # distinguishable from "one was seen and its allowance is the default",
    # or the first mount could never lower it.
    sg_desc_allow=''
    sg_best_len=-1
    # Precomputed, and NOT inlined into the case pattern below. In bash,
    # `case "$m" in "${p%/}"/*)` fails to match /scratch when p=/ and the
    # expansion is empty, while the identical pattern built from an already
    # assigned variable matches. That difference silently allowed every walk
    # rooted at / -- including an unbounded `grep -rhoE ... /`.
    sg_prefix=${sg_path%/}

    sg_load_mounts
    for sg_pair in $sg_expensive; do
        # Split on the LAST colon: an fstype never contains one, and a mount
        # point legally may.
        sg_mnt=${sg_pair%:*}
        sg_fs=${sg_pair##*:}

        sg_depth_below "$sg_path" "$sg_mnt"
        if [ "$sg_below" -ge 0 ]; then
            # Most specific containing mount wins, so keep the longest match:
            # /scratch must beat / for a path underneath it.
            if [ ${#sg_mnt} -gt "$sg_best_len" ]; then
                sg_best_len=${#sg_mnt}
                if [ "$sg_below" -lt "$SG_UNSCOPED_DEPTH" ]; then
                    sg_reason=at_or_near_root
                    sg_hit_mount=$sg_mnt
                    sg_hit_fs=$sg_fs
                    sg_hit_root=$sg_raw
                else
                    sg_reason=''
                    sg_hit_mount=''
                fi
            fi
            continue
        fi
        case "$sg_mnt" in
            "$sg_prefix"/*)
                # The STRICTEST allowance over every mount this walk enters,
                # tracked here where each descended mount is in hand. It is
                # deliberately not the allowance of the mount named below:
                # that ranking answers what the refusal SAYS, it ties for
                # two mounts of one type, and this file broke that
                # tie by /proc/mounts order while search_rules.py broke it by
                # path length. Harmless while it only chose a name; the moment
                # it chose a verdict, `find / -maxdepth 4` was refused here
                # and allowed by the table, and swapping two lines of
                # /proc/mounts flipped it. See root_depth_allowance().
                #
                # Computed for EVERY refusal, not only a depth-bounded one:
                # the refusal text advises a bound, and it has to advise the
                # ceiling that would actually be accepted. An unbounded walk
                # never sets sg_depthval, so gating this on it left exactly
                # those refusals -- the commonest kind -- with nothing to
                # advise but the global default.
                sg_allowance "$sg_mnt"
                if [ -z "$sg_desc_allow" ] \
                   || [ "$sg_allow" -lt "$sg_desc_allow" ]; then
                    sg_desc_allow=$sg_allow
                fi
                # Ranked worst-first, in SG_FSTYPES order: a walk from `/`
                # descends into the parallel filesystem and into a small NFS
                # export alike, and naming the cheaper one in the refusal
                # would cite the wrong reason. A type no glob matches -- remote
                # by proxy, or an override -- ranks after every listed one.
                # Then shallowest-first among equal severity, matching
                # offending_mount()'s `(severity, len(mount))` -- first-wins
                # left the two consumers naming different mounts for the same
                # command, which is a divergence report waiting to happen even
                # now that it cannot change a verdict.
                sg_sev=0
                for sg_f in $SG_FSTYPES; do
                    # shellcheck disable=SC2254
                    case "$sg_fs" in
                        $sg_f) break ;;
                    esac
                    sg_sev=$((sg_sev + 1))
                done
                if [ "$sg_sev" -lt "$sg_desc_sev" ] \
                   || { [ "$sg_sev" -eq "$sg_desc_sev" ] \
                        && [ ${#sg_mnt} -lt "$sg_desc_len" ]; }; then
                    sg_desc_sev=$sg_sev
                    sg_desc_len=${#sg_mnt}
                    sg_desc_mount=$sg_mnt
                    sg_desc_fs=$sg_fs
                fi
                ;;
        esac
    done

    # A DEVICE bound answers exactly this reason and no other. `find / -xdev`
    # never crosses onto /scratch, so citing it is a refusal that is wrong
    # about the user's command -- and the durable fix a user adopts for that
    # is `/usr/bin/find` in an alias, after which this layer is off for them
    # on every command. `at_or_near_root` is untouched above: the walk starts
    # ON the expensive mount there, and `find /scratch -xdev` still
    # enumerates the whole mount.
    if [ -z "$sg_reason" ] && [ -n "$sg_desc_mount" ] && [ "$sg_devbound" -eq 0 ]; then
        sg_reason=descends_into
        sg_hit_mount=$sg_desc_mount
        sg_hit_fs=$sg_desc_fs
        sg_hit_root=$sg_raw
    fi

    # The DEPTH ceiling is per-mount, so it can only be applied now that the
    # mounts are known -- which is why the comparison is not back where the
    # depth flag was parsed. Reaching here with sg_depthval set means the
    # caller asked for MORE than SG_MAXDEPTH and these mounts are being asked
    # whether they allow that. sg_depthval, not sg_depth: the latter is this
    # tool's depth FLAG LIST, set by the per-profile case arm and read by the
    # refusal text.
    #
    # A walk that STARTS on the mount is judged by that mount. A walk that
    # descends is judged by the strictest of everything it enters, summed up
    # in the loop above -- never by the one mount the refusal happens to name.
    #
    # Resolved whenever there is a reason, not only when there is a depth
    # value, because the refusal text reads sg_allow too. One resolution for
    # both readers is the point: a message advising a different number from
    # the one the verdict enforces is how a user learns the guard is lying.
    if [ -n "$sg_reason" ]; then
        if [ "$sg_reason" = descends_into ]; then
            # Never empty here: descends_into is set only when a descended
            # mount was found, which is the same condition under which the
            # loop above recorded that mount's allowance.
            sg_allow=$sg_desc_allow
        else
            sg_allowance "$sg_hit_mount"
        fi
    fi
    if [ -n "$sg_reason" ] && [ -n "$sg_depthval" ]; then
        if [ "$sg_depthval" -le "$sg_allow" ]; then
            sg_reason=''
            sg_hit_mount=''
            sg_hit_fs=''
            sg_hit_root=''
        fi
    fi
    [ -n "$sg_reason" ]
}

# --- the directory relative operands resolve against ------------------------
# fd's --base-directory is a COORDINATE SYSTEM, not a root: with an explicit
# operand fd walks the operand resolved against the base, not the base itself.
# Modelling it as a root flag both allowed `--base-directory /tmp pat
# ../scratch` (which fd walks as /scratch) and refused `--base-directory
# /scratch pat /tmp/cheap` (which fd walks as /tmp/cheap). Last one wins.
#
# Walked with the SAME grammar as every other scan here. The first version was
# a plain `for sg_a in "$@"` and that was a bypass: in
# `fd -x echo --base-directory /tmp/cheap` the flag is command-TEMPLATE data,
# fd still walks the original cwd, and switching the base to the cheap path
# while the root scan correctly skipped the template let an expensive cwd walk
# through. Same for a flag after `--` or consumed as another option's value.
sg_base=$PWD
if [ -n "$sg_cwdflags" ]; then
    sg_want_base=0
    sg_b_pending=0
    sg_b_exec=0
    sg_b_plus=0
    sg_b_prev=''
    for sg_a in "$@"; do
        if [ "$sg_b_exec" -eq 1 ]; then
            if [ "$sg_a" = ';' ]; then
                sg_b_exec=0
            elif [ "$sg_b_plus" -eq 1 ] && [ "$sg_a" = '+' ] \
                 && [ "$sg_b_prev" = '{}' ]; then
                sg_b_exec=0
            else
                sg_b_prev=$sg_a
            fi
            continue
        fi
        if [ "$sg_want_base" -eq 1 ]; then
            sg_want_base=0
            case "$sg_a" in
                /*) sg_base=$sg_a ;;
                *) sg_base=$PWD/$sg_a ;;
            esac
            continue
        fi
        if [ "$sg_b_pending" -eq 1 ]; then
            sg_b_pending=0
            continue
        fi
        if sg_in "$sg_a" "$sg_execflags"; then
            sg_b_exec=1
            sg_b_prev=''
            if sg_in "$sg_a" "$sg_execplus"; then sg_b_plus=1; else sg_b_plus=0; fi
            continue
        fi
        # Past `--` a flag-shaped token is an operand, so it cannot change
        # the coordinate system.
        [ "$sg_a" = '--' ] && break
        if sg_in "$sg_a" "$sg_cwdflags"; then
            sg_want_base=1
            continue
        fi
        sg_hitbase=0
        for sg_f in $sg_cwdflags; do
            case "$sg_a" in
                "$sg_f"=*)
                    case "${sg_a#*=}" in
                        /*) sg_base=${sg_a#*=} ;;
                        *) sg_base=$PWD/${sg_a#*=} ;;
                    esac
                    sg_hitbase=1
                    ;;
            esac
            [ "$sg_hitbase" -eq 1 ] && break
        done
        [ "$sg_hitbase" -eq 1 ] && continue
        # A CLUSTER's value-taking letter consumes the next token, so that
        # token is not an option: `fd -HE --base-directory /tmp/cheap pat`
        # has -E eat the flag, and missing that let an expensive cwd walk resolve
        # against a false cheap base. Before the exact-match test below,
        # which never sees `-HE`.
        if sg_parse_cluster "$sg_a" && [ -n "$sg_cl_vflag" ]; then
            [ "$sg_cl_next" -eq 1 ] && sg_b_pending=1
            continue
        fi
        # Another option's VALUE is not an option. After the cwd flags above,
        # since those are value flags too.
        if sg_in "$sg_a" "$sg_value"; then
            sg_b_pending=1
        fi
    done
fi

# --- roots ------------------------------------------------------------------
# Each root is judged the moment it is identified, so no list of operands is
# ever stored and word-split -- a path with a space in it would not survive
# that, and would not survive it loudly.
sg_rootscan() {
    # One pass over argv, charging every path operand it finds. Self-
    # initialising, because it is run TWICE for the profiles that need it and
    # "remember to reset the state between passes" is not a discipline worth
    # depending on -- every latch it sets is cleared here, in one place.
    sg_nroots=0
    sg_saw_pat=0
    sg_want_value=0
    sg_want_root=0
    sg_seen_pos=0
    sg_ended=0
    sg_no_more_flags=0
    sg_leadroot=0
    sg_skipnext=0
    sg_r_exec=0
    sg_r_plus=0
    sg_r_prev=''

    for sg_a in "$@"; do
        [ "$sg_ended" -eq 1 ] && break

        if [ "$sg_mode" = leading ]; then
            # find's grammar: `find [-H|-L|-P] path... expression`. The first
            # expression token ends the operand list, and nothing after it is a
            # path -- not even the value of a flag. Handled before the generic
            # flag logic so that `find -maxdepth 2 /scratch`, where the paths
            # come after a flag, is read the same way the rule table reads it.
            if [ "$sg_leadroot" -eq 1 ]; then
                # The value of a leading root flag: a path, judged like any other.
                sg_leadroot=0
                sg_charge "$sg_a" && break
                continue
            fi
            if [ "$sg_skipnext" -eq 1 ]; then
                sg_skipnext=0
                continue
            fi
            # A leading root flag supplies a root itself (`bfs -f PATH`), so
            # it has to be recognized before the generated prefix/value/glued
            # arms below -- generated once from find's own leading grammar,
            # shared by every leading-mode tool, so they carry no notion of a
            # per-tool root flag. A runtime check against $sg_rootflags
            # (already emitted per profile, and already read this way by the
            # non-leading root scan further down) reads each tool's own value
            # instead of one compiled from find's alone. Empty for find/gfind,
            # so this never matches for them -- `-f` is bfs's, not find's.
            if sg_in "$sg_a" "$sg_rootflags"; then
                sg_leadroot=1
                continue
            fi
            case "$sg_a" in
                --)
                    # End of options, not end of operands: `find -- /scratch`
                    # walks /scratch. Matched before the `-*` arm below, which
                    # would otherwise swallow it and drop every operand after it.
                    #
                    # For bfs that is true wherever `--` appears, so the
                    # operand list carries on through it: measured on bfs 2.1
                    # and 4.0.4, `bfs d1 -- d2` exits 0 and walks BOTH. Reading
                    # find's grammar here let `bfs /tmp/cheap -- /scratch`
                    # charge only the cheap operand and ALLOW -- and since bfs
                    # is user-installed it gets no shim, so the table made the
                    # same mistake and the reaper recorded nothing.
                    #
                    # find is the opposite after an operand: `find d1 -- d2` is
                    # an unknown predicate, rc=1, and walks nothing, so ending
                    # the list is right for it.
                    [ "$sg_dashdash" = end_of_options ] && continue
                    [ "$sg_nroots" -eq 0 ] && continue
                    sg_ended=1; continue ;;
                # GENERATED from FIND_PREFIX_FLAGS and FIND_VALUE_LEADING_FLAGS,
                # so this cannot drift from the table the way it silently had:
                # both sides carried their own hardcoded copy of "find's
                # leading options", and neither knew bfs's.
                @@FIND_PREFIX@@) continue ;;
                @@FIND_VALUE_LEAD@@) sg_skipnext=1; continue ;;
                @@FIND_GLUED@@) continue ;;
                # A bare `-` is a PATH OPERAND, not the start of the
                # expression, so it must not end the operand list. Measured:
                # with a real directory named `-` in the cwd, both
                # `find - -name x` and `bfs - -name x` walk it and exit 0. With
                # no such file they error on the dash -- `find: '-': No such
                # file or directory` -- and then walk every remaining operand
                # anyway, so `find d1 - d2` walks BOTH d1 and d2.
                #
                # Ending the list here charged d1 and threw d2 away, which hid
                # a NAMED expensive path from both layers at every cwd, not
                # just a cheap one: the reaper saw a parsed argv with a cheap
                # root and recorded nothing at all.
                #
                # No arm body, so it falls out of the case to sg_charge below
                # and is judged like any other relative operand -- against the
                # cwd, without asking the filesystem whether `./-` exists,
                # exactly as `find runs` is judged. The positional ladder
                # further down has had this same `-) ;;` exception all along;
                # leading mode was the one path that missed it.
                -) ;;
                -*)
                    # A cluster of PURE boolean prefix flags, getopt-style:
                    # `-HL` is `-H` plus `-L`, both real (`bfs -HL clu
                    # -maxdepth 0` walks clu; GNU find calls `-HL` an unknown
                    # predicate and never reaches this arm since it never
                    # clusters). sg_parse_cluster only succeeds with an empty
                    # sg_cl_vflag when EVERY letter in the token is in
                    # $sg_cluster -- anything else, including -regextype,
                    # falls through to sg_ended below exactly as before.
                    # Measured before this existed: this dispatcher exec'd the
                    # real binary for `bfs -HL /scratch -maxdepth 1` with the
                    # SAME cwd-fallback loss the table had -- a real path
                    # silently swapped for a cheap one.
                    if sg_parse_cluster "$sg_a" && [ -z "$sg_cl_vflag" ] \
                       && [ -n "$sg_cl_letters" ]; then
                        continue
                    fi
                    sg_ended=1; continue ;;
                '('|')'|'!'|',') sg_ended=1; continue ;;
            esac
            sg_charge "$sg_a" && break
            continue
        fi

        if [ "${sg_r_exec:-0}" -eq 1 ]; then
            if [ "$sg_a" = ';' ]; then
                sg_r_exec=0
            elif [ "${sg_r_plus:-0}" -eq 1 ] && [ "$sg_a" = '+' ] \
                 && [ "${sg_r_prev:-}" = '{}' ]; then
                sg_r_exec=0
            else
                sg_r_prev=$sg_a
            fi
            continue
        fi
        if [ "$sg_want_root" -eq 1 ]; then
            sg_want_root=0
            sg_charge "$sg_a" && break
            continue
        fi
        if [ "$sg_want_value" -eq 1 ]; then
            sg_want_value=0
            continue
        fi

        # `--` ends the OPTIONS, not the arguments: everything after it is a
        # positional, so `grep -r -- pat /scratch` still names /scratch as a
        # root. Reading it as end-of-arguments dropped every operand after it and
        # fell back to the cwd -- a two-character bypass of this layer that the
        # reaper went on reporting. Tested in both consumers; see the
        # end-of-options rows in tests/test_search_rules.py.
        #
        # Checked AFTER the pending-value branches above, because a `--` consumed
        # by a flag is that flag's value: in `grep -e -- file` the pattern is `--`.
        if [ "$sg_no_more_flags" -eq 0 ]; then
            if [ "$sg_a" = '--' ]; then
                sg_no_more_flags=1
                continue
            fi

            # A command TEMPLATE's tokens are data. Charging one as a root is
            # the unsafe direction, not the safe one: it stops the fall-back to
            # the cwd, so `fd -x echo {} /tmp/cheap` from an expensive cwd was allowed
            # while fd walked the cwd.
            if sg_in "$sg_a" "$sg_execflags"; then
                sg_r_exec=1
                sg_r_prev=''
                if sg_in "$sg_a" "$sg_execplus"; then sg_r_plus=1; else sg_r_plus=0; fi
                continue
            fi

            if sg_in "$sg_a" "$sg_rootflags"; then
                sg_want_root=1
                continue
            fi
            sg_matched=0
            for sg_f in $sg_rootflags; do
                case "$sg_a" in
                    "$sg_f"=*)
                        if sg_charge "${sg_a#*=}"; then sg_matched=2; else sg_matched=1; fi
                        ;;
                esac
                [ "$sg_matched" -ne 0 ] && break
            done
            [ "$sg_matched" -eq 2 ] && break
            [ "$sg_matched" -eq 1 ] && continue

            # An ABBREVIATED root flag still supplies a root, and missing it was a
            # false refusal: `updatedb --database-r /var/tmp/things` is accepted by
            # updatedb, but the value was discarded and the walk fell back to
            # default_root `/`. Before the generic abbreviated-value branch, which
            # would otherwise swallow it.
            #
            # updatedb is no longer wrapped, and it was the only tool that both
            # abbreviated and took a root flag, so nothing reaches this arm today
            # (fzf's --walker-root is exact-only -- clap rejects prefixes). Kept
            # because the grammar belongs to getopt_long rather than to updatedb;
            # see roots() in search_rules.py.
            if sg_resolve_long "${sg_a%%=*}" "$sg_rootflags"; then
                case "$sg_a" in
                    *=*)
                        sg_charge "${sg_a#*=}" && break
                        ;;
                    *) sg_want_root=1 ;;
                esac
                continue
            fi

            if sg_in "$sg_a" "$sg_pat"; then
                sg_saw_pat=1
                sg_want_value=1
                continue
            fi
            # A pattern flag can carry its pattern inline (`--regexp=pat`) or sit
            # inside a cluster (`-nefoo`, `-ne foo`). Matching only exact tokens
            # left sg_saw_pat clear, so the first PATH operand was charged against
            # sg_skip as if it were the pattern -- `grep -nefoo -r /home` lost
            # /home and fell back to the cwd.
            sg_attached=0
            for sg_f in $sg_pat; do
                case "$sg_a" in
                    "$sg_f"=*) sg_attached=1; break ;;
                esac
            done
            if [ "$sg_attached" -eq 1 ]; then
                sg_saw_pat=1
                continue
            fi
            # ...and an abbreviated one: `--rege pat`, `--rege=pat`. Missing it
            # leaves sg_saw_pat clear, so the first real PATH operand is charged
            # against sg_skip as though it were the pattern.
            if sg_resolve_long "${sg_a%%=*}" "$sg_pat"; then
                sg_saw_pat=1
                case "$sg_a" in
                    *=*) ;;
                    *) sg_want_value=1 ;;
                esac
                continue
            fi
            case "$sg_a" in
                --*) ;;
                -?*)
                    if sg_parse_cluster "$sg_a" && [ -n "$sg_cl_vflag" ]; then
                        if sg_in "$sg_cl_vflag" "$sg_pat"; then
                            sg_saw_pat=1
                        fi
                        [ "$sg_cl_next" -eq 1 ] && sg_want_value=1
                        continue
                    fi
                    ;;
            esac
            if sg_in "$sg_a" "$sg_value"; then
                sg_want_value=1
                continue
            fi
            # ...and an ABBREVIATED value flag consumes its value too. Without
            # this the root scan charged the wrong path entirely:
            # `grep --di recurse hay` is `--directories recurse`, so grep
            # RECURSES THE CWD with `hay` as the pattern (verified on the tool --
            # it matched a file three levels down), while this read `recurse` as the
            # pattern and `hay` as a path. From an expensive cwd with a cheap-looking
            # operand that was a BYPASS. After the pattern arms above, because
            # sg_pat is a subset of sg_value and has to set sg_saw_pat first.
            if sg_resolve_long "${sg_a%%=*}" "$sg_value"; then
                case "$sg_a" in
                    *=*) ;;
                    *) sg_want_value=1 ;;
                esac
                continue
            fi

            case "$sg_a" in
                -) ;;
                -*) continue ;;
            esac
        fi

        # fzf has no path grammar; its positionals are never roots.
        [ "$sg_mode" = stdin ] && continue

        # A positional. For grep/rg/fd the first one is the pattern, unless a
        # pattern flag already supplied it.
        sg_seen_pos=$((sg_seen_pos + 1))
        if [ "$sg_saw_pat" -eq 0 ] && [ "$sg_seen_pos" -le "$sg_skip" ]; then
            continue
        fi
        sg_charge "$sg_a" && break
    done
}

# `grep -r DIR -e pat` searches DIR: a pattern flag ANYWHERE makes EVERY
# positional a path, so which one is the pattern cannot be known until argv
# has been read to the end. The table says exactly that in a line --
# `skip = 0 if saw_pattern_flag else profile.skip_pos` -- because it scans
# first and slices after. This scanner charged as it went and read sg_saw_pat
# the moment it met the positional, so `rg /scratch -e pat` threw /scratch
# away as the pattern three tokens before the -e that proved it was not, fell
# back to the cwd, and ALLOWED a recursive walk the table refused.
# The same bug wears a second face: `rg /tmp/cheap -xdev` reaches
# -e inside the cluster, so the table frees /tmp/cheap to be a path and
# allows, while this refused it against the cwd.
#
# So: run the SAME scan twice, the first time dry. Not a second, simpler
# pre-scan -- the cwd pre-pass above warns from experience that one of those
# is itself a bypass, because it has to re-derive exec bodies, `--` and value
# consumption, and will drift from the ladder it copies. These are the same
# lines, so they cannot drift.
#
# Only a profile that can actually disagree pays for it: a pattern flag has to
# exist AND a positional has to be skipped, which is grep, rgrep and rg. One
# extra argv pass of shell builtins, no fork, and off the fast path.
sg_dry=0
if [ -n "$sg_pat" ] && [ "$sg_skip" -gt 0 ]; then
    sg_dry=1
    sg_rootscan "$@"
    sg_dry=0
    # A pattern flag was found somewhere, so nothing is skipped on the real
    # pass and every positional is a path.
    [ "$sg_saw_pat" -eq 1 ] && sg_skip=0
fi
sg_rootscan "$@"

if [ "$sg_nroots" -eq 0 ] && [ -z "$sg_reason" ]; then
    # No FILE operand, so the default depth never applied: ugrep's fallback
    # here is an implicit -R over the working directory and is UNBOUNDED.
    # Only an EXPLICIT bound survives into this judgement.
    sg_depthval=$sg_expldepth
    if [ "$sg_mode" = stdin ]; then
        # fzf with a pipe on stdin is a filter over someone else's output and
        # walks nothing. With a terminal on stdin it walks the cwd.
        [ -t 0 ] && sg_judge "$sg_base"
    elif [ "$sg_ttyfallback" -eq 1 ]; then
        # ugrep: same split, but it DOES take path operands, so it cannot use
        # stdin mode. `ugrep pat` at a prompt recurses the cwd; the same argv
        # on the end of a pipe filters the pipe and walks nothing. Layer 2
        # reads /proc/<pid>/fd/0 to answer the same question -- see
        # ADR-0011.
        [ -t 0 ] && sg_judge "$sg_default"
    else
        sg_judge "$sg_default"
    fi
fi

if [ -z "$sg_reason" ] && [ -n "$WALK_BLOCKER_MOUNTS" ]; then
    # `-n`, not `${WALK_BLOCKER_MOUNTS+set}`: SG_MOUNTS above falls back to
    # @@MOUNTS_DEFAULT@@ via `:-`, which treats an explicit empty override
    # the same as an unset one, so WALK_BLOCKER_MOUNTS='' can never itself
    # cause a divergence -- matching that here skips the fork for a case
    # that would only ever find "no difference".
    #
    # WALK_BLOCKER_MOUNTS is a test seam for sg_load_mounts. Pointed at an
    # empty or unreadable table it makes THIS invocation see zero expensive
    # mounts, which reads as "no opinion" and falls straight through to
    # sg_exec_real below with nothing recorded -- unlike WALK_BLOCKER_UNSCOPED,
    # silently. Re-judge the SAME operands against the real table in a
    # subshell -- not the fast path: this only runs when the caller set the
    # var at all, which no production invocation does -- and audit the
    # divergence rather than trust the override.
    #
    # sg_rootscan runs a THIRD time here in some invocations (the dry
    # pattern-detection pass above is already a second), a precedented shape
    # in this file rather than a new idiom, and the subshell means none of
    # its state -- sg_reason included -- leaks into the verdict that already
    # let this walk through.
    sg_shadow=$(
        SG_MOUNTS=$SG_MOUNTS_TRUSTED
        sg_mounts_loaded=0
        sg_expensive=''
        sg_reason=''
        sg_hit_mount=''
        sg_hit_fs=''
        sg_hit_root=''
        sg_dry=0
        if [ -n "$sg_pat" ] && [ "$sg_skip" -gt 0 ]; then
            sg_dry=1
            sg_rootscan "$@"
            sg_dry=0
            [ "$sg_saw_pat" -eq 1 ] && sg_skip=0
        fi
        sg_rootscan "$@"
        if [ "$sg_nroots" -eq 0 ] && [ -z "$sg_reason" ]; then
            # Re-cleared inside the subshell: it inherits sg_depthval from the
            # outer scope, where the default may already have been applied.
            sg_depthval=$sg_expldepth
            if [ "$sg_mode" = stdin ]; then
                [ -t 0 ] && sg_judge "$sg_base"
            elif [ "$sg_ttyfallback" -eq 1 ]; then
                [ -t 0 ] && sg_judge "$sg_default"
            else
                sg_judge "$sg_default"
            fi
        fi
        # '|'-joined: none of these three fields can legitimately contain a
        # literal '|' today (a mount point that could is already excluded by
        # the whitespace-escape skip in sg_load_mounts), and a hostile one
        # only mis-splits this internal handoff -- the record it feeds still
        # goes through sg_audit_emit's own JSON escaping, so a misparse here
        # is cosmetic, not a safety issue.
        printf '%s|%s|%s' "$sg_reason" "$sg_hit_mount" "$sg_hit_fs"
    )
    sg_shadow_reason=${sg_shadow%%|*}
    sg_shadow_rest=${sg_shadow#*|}
    sg_shadow_mount=${sg_shadow_rest%%|*}
    sg_shadow_fs=${sg_shadow_rest#*|}
    if [ -n "$sg_shadow_reason" ]; then
        # The override actually suppressed a refusal the real mount table
        # would have produced -- audited, not silent, same as
        # WALK_BLOCKER_UNSCOPED.
        sg_audit_emit unaudited_seam WALK_BLOCKER_MOUNTS '' \
            "$sg_shadow_mount" "$sg_shadow_fs" "$sg_shadow_reason" '' ''
    fi
fi

if [ -z "$sg_reason" ] && [ -n "$WALK_BLOCKER_FSTYPES$WALK_BLOCKER_DEPTH_BY_MOUNT" ]; then
    # ONE combined shadow for both, not two separate ones: the first cut of
    # this fix had them separate, mirroring WALK_BLOCKER_MOUNTS' one-block-
    # per-seam shape, and that was itself a silent gap. Each block forced
    # only ITS OWN variable to trusted while leaving the OTHER at its live
    # value, so a caller setting BOTH at once in a complementary way --
    # FSTYPES narrowed to hide a mount, DEPTH_BY_MOUNT loosened for that
    # same mount -- passed through NEITHER shadow's own check, because each
    # one's re-judge still saw the other override's effect and agreed with
    # the live verdict. Measured against the fixture table: a depth-bounded
    # walk of the parallel filesystem with WALK_BLOCKER_FSTYPES narrowed to
    # the NFS type and WALK_BLOCKER_DEPTH_BY_MOUNT loosened for that same
    # mount was allowed silently, no audit record at all, though the real
    # table and the real ceiling both refuse it. Forcing the type list, its
    # ERE form and the override table to their trusted values in the SAME
    # subshell closes that.
    #
    # A residual gap remains, deliberately not closed here: WALK_BLOCKER_
    # MOUNTS is not forced trusted in this block, so a THIRD combination --
    # MOUNTS plus either of these two -- could still mask each other the
    # same way. All three are test seams no production invocation sets at
    # all; closing it is a change to the MOUNTS block above, recorded rather
    # than made.
    sg_seam_label=''
    [ -n "$WALK_BLOCKER_FSTYPES" ] && sg_seam_label=WALK_BLOCKER_FSTYPES
    if [ -n "$WALK_BLOCKER_DEPTH_BY_MOUNT" ]; then
        if [ -n "$sg_seam_label" ]; then
            sg_seam_label="${sg_seam_label}+WALK_BLOCKER_DEPTH_BY_MOUNT"
        else
            sg_seam_label=WALK_BLOCKER_DEPTH_BY_MOUNT
        fi
    fi
    sg_shadow=$(
        SG_FSTYPES=$SG_FSTYPES_TRUSTED
        SG_FSTYPES_RE=$SG_FSTYPES_RE_TRUSTED
        SG_MOUNT_OVERRIDES=$SG_MOUNT_OVERRIDES_TRUSTED
        sg_mounts_loaded=0
        sg_expensive=''
        sg_reason=''
        sg_hit_mount=''
        sg_hit_fs=''
        sg_hit_root=''
        sg_dry=0
        if [ -n "$sg_pat" ] && [ "$sg_skip" -gt 0 ]; then
            sg_dry=1
            sg_rootscan "$@"
            sg_dry=0
            [ "$sg_saw_pat" -eq 1 ] && sg_skip=0
        fi
        sg_rootscan "$@"
        if [ "$sg_nroots" -eq 0 ] && [ -z "$sg_reason" ]; then
            # Re-cleared inside the subshell: it inherits sg_depthval from the
            # outer scope, where the default may already have been applied.
            sg_depthval=$sg_expldepth
            if [ "$sg_mode" = stdin ]; then
                [ -t 0 ] && sg_judge "$sg_base"
            elif [ "$sg_ttyfallback" -eq 1 ]; then
                [ -t 0 ] && sg_judge "$sg_default"
            else
                sg_judge "$sg_default"
            fi
        fi
        printf '%s|%s|%s' "$sg_reason" "$sg_hit_mount" "$sg_hit_fs"
    )
    sg_shadow_reason=${sg_shadow%%|*}
    sg_shadow_rest=${sg_shadow#*|}
    sg_shadow_mount=${sg_shadow_rest%%|*}
    sg_shadow_fs=${sg_shadow_rest#*|}
    if [ -n "$sg_shadow_reason" ]; then
        sg_audit_emit unaudited_seam "$sg_seam_label" '' \
            "$sg_shadow_mount" "$sg_shadow_fs" "$sg_shadow_reason" '' ''
    fi
fi

[ -n "$sg_reason" ] || sg_exec_real "$@"

# --- refuse -----------------------------------------------------------------
# Look for the shape that started this: a scheduler job id in a filename
# pattern. Slurm records where it put the output; searching for it is rediscovering a
# fact the scheduler never lost.
sg_jobid=''
for sg_a in "$@"; do
    case "$sg_a" in
        *slurm-*)
            sg_t=${sg_a#*slurm-}
            sg_t=${sg_t%%[!0-9]*}
            [ -n "$sg_t" ] && sg_jobid=$sg_t
            ;;
    esac
done

if [ -n "$WALK_BLOCKER_UNSCOPED" ]; then
    # The escape hatch is audited, not silent. A block with no override gets
    # routed around with `\find`, and then nothing is measurable at all.
    # See sg_audit_emit() above for the sinks and the escaping this shares
    # with the two unaudited-seam checks.
    sg_audit_emit escape_hatch '' "$sg_hit_root" "$sg_hit_mount" \
        "$sg_hit_fs" "$sg_reason" '' ''
    sg_exec_real "$@"
fi

if [ "$sg_reason" = descends_into ]; then
    sg_why="starts above $sg_hit_mount and descends into it"
else
    sg_why="starts at or just inside $sg_hit_mount"
fi

{
    printf 'REFUSED: %s %s would walk %s (%s) unbounded -- it %s.\n' \
        "$sg_tool" "$sg_hit_root" "$sg_hit_mount" "$sg_hit_fs" "$sg_why"
    if [ -n "$sg_jobid" ]; then
        # BOTH are named, because they fail in opposite directions and a
        # reader who only gets one will conclude the guard is useless.
        #
        # sacct queries slurmdbd, so it is durable and it does carry StdOut,
        # StdErr, WorkDir and SubmitLine. What it will not do is show a job
        # the caller's accounting permissions do not cover -- and an empty
        # sacct table looks identical to a broken one, which is how this
        # refusal briefly came to recommend scontrol INSTEAD. It was wrong:
        # `sudo sacct -j <id> -o StdOut,StdErr,WorkDir` returns the row.
        #
        # scontrol reads slurmctld's memory instead, so it answers for any
        # recent job regardless of accounting, and forgets it MinJobAge --
        # the site's `[slurm].min_job_age_s`, compiled in below -- after it
        # ends.
        #
        # And the split is not only about durability. Measured at a
        # reference deployment: sacct returns StdOut as stored -- the output
        # pattern with `%j` UNEXPANDED -- while scontrol prints the resolved
        # filename. A reader given only sacct copies a path that does not
        # exist, which is worse than an empty answer because it looks like
        # one that worked.
        #
        # `[slurm].extra_job_tools` adds one line per site-local triage
        # command, after the two the scheduler itself provides; none is the
        # default.
        printf '\nYou are looking for the output of Slurm job %s. Ask Slurm:\n' "$sg_jobid"
        printf '    sacct -j %s -o JobID,StdOut,StdErr,WorkDir\n' "$sg_jobid"
        printf '    scontrol show job %s | grep -E "StdOut|StdErr|WorkDir"\n' "$sg_jobid"
@@EXTRA_JOB_TOOLS@@        printf 'sacct is durable, but scoped to jobs your account may see AND\n'
        printf 'it returns StdOut with %%j unexpanded -- substitute the job id.\n'
        printf 'scontrol prints the resolved path, for @@MIN_JOB_AGE@@s after the job ends.\n'
    fi
    # A device bound is offered only for the reason it can actually answer.
    # `-xdev` does nothing for a walk that STARTS on the expensive mount, and
    # advice that does not work is how a refusal stops being read at all.
    if [ "$sg_reason" = descends_into ] && [ -n "$sg_devflags" ]; then
        printf '\nOr keep the walk on the filesystem it starts from:\n'
        for sg_f in $sg_devflags; do
            printf '    %s %s ...\n' "$sg_tool" "$sg_f"
            break
        done
    fi
    if [ -n "$sg_depth" ]; then
        for sg_f in $sg_depth; do
            # sg_allow, not SG_MAXDEPTH: on a mount with a measured
            # allowance the global default is stricter than the guard
            # requires, so advising it told the user to go shallower than
            # they had to -- `find /home -maxdepth 6` was refused with
            # "bound to 2" when 4 is permitted, on the one mount where a
            # measurement bought the extra depth.
            printf '\nOr bound the walk: %s %s ...\n' "$sg_f" "$sg_allow"
            break
        done
        # locate(1) is deliberately NOT named here: a typical updatedb
        # configuration prunes network filesystem types and the mounts they
        # sit on, so the database holds nothing under any path this guard
        # refuses, and advice that returns zero results for the path the user
        # was just refused teaches them to stop reading the message
        # (ADR-0007).
        printf 'Or start deeper than %s components below %s.\n' \
            "$SG_UNSCOPED_DEPTH" "$sg_hit_mount"
    else
        if [ -n "$sg_outdepth" ]; then
            # A tool whose depth-looking flags prune OUTPUT, not traversal.
            # Naming them is the point: telling someone who just typed `-d 2`
            # that their tool "has no depth flag" reads as a lie, and the
            # generic arm below would answer a size question with a content
            # search (`rg --max-depth`) and with `find -exec du {} +`, which
            # sums the files find enumerated rather than the subtree.
            printf '\n%s cannot be bounded by depth. Its depth-looking flags (%s)\n' \
                "$sg_tool" "$sg_outdepth"
            printf 'prune the OUTPUT, not the walk: a total cannot be known without\n'
            printf 'reading everything below it. There is no shallower form of this\n'
            printf 'question -- start deeper than %s components below %s.\n' \
                "$SG_UNSCOPED_DEPTH" "$sg_hit_mount"
        else
            printf '\n%s has no depth flag, so this walk cannot be bounded. Either:\n' "$sg_tool"
            printf '    rg --max-depth %s PATTERN PATH\n' "$SG_MAXDEPTH"
            printf '    find PATH -maxdepth %s -type f -exec %s ... {} +\n' "$SG_MAXDEPTH" "$sg_tool"
            printf 'or start deeper than %s components below %s.\n' "$SG_UNSCOPED_DEPTH" "$sg_hit_mount"
        fi
    fi
    # The general alternative, offered for every refusal, because it is the
    # only one that answers a question about the whole filesystem. Named
    # rather than explained: `walk-job -h` is on the node and this message is
    # already at the length where people stop reading.
    printf '\nOr run it off the login node, under a limit the scheduler enforces:\n'
    printf '    walk-job -- %s ...          # see walk-job -h\n' "$sg_tool"

    printf '\nThis guard is advisory: /usr/bin/%s bypasses it. Set @@ESCAPE@@=1 to\n' "$sg_tool"
    printf 'override this refusal; overrides are recorded in the journal:\n'
    printf '    journalctl -t walk-blocker -o json\n'
    printf 'where _UID is stamped by journald from the socket, not taken from\n'
    printf 'the environment being audited.\n'
@@DOCS_LINE@@@@CONTACT_LINE@@    # Last line on purpose: it is for the person answering the report, not the
    # person reading the refusal, and it must not push the remedy off-screen.
    printf '\nwalk-blocker %s\n' "$SG_VERSION"
} >&2

exit @@EXIT@@
