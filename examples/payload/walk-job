#!/bin/sh
# Submit a filesystem traversal to the scheduler instead of running it on the
# login node. This is the sanctioned alternative Layer 1's refusal points at
# for an expensive mount, where there is no index and cannot be one -- see
# docs/adr/0007-no-namespace-index.md.
#
#   walk-job -- du -sh /scratch/some/dataset
#   walk-job -t 4:00:00 -- find /scratch/some/dataset -name '*.ckpt'
#
# What this buys, and what it does not:
#
#   It buys a WALL-CLOCK bound, enforced by the scheduler. A namespace large
#   enough to need this cannot be bounded by -maxdepth without also answering
#   a different question than the user asked, so the bound moves to the axis
#   that still works. Unlike -maxdepth this is not advisory: the scheduler
#   kills the job, so a walk nobody is watching any more still ends.
#
#   It buys the login node's responsiveness back for everyone sharing it.
#
#   It does NOT make the walk cheap. The same metadata operations hit the same
#   storage cluster from a different client. This moves load off the login
#   node, not off the filesystem. A walk that should not happen at all is not
#   fixed by submitting it.
#
# POSIX sh, no bashisms: this runs on the login node, whose shell this
# project does not choose, and it must keep working if /bin/sh is dash
# (ADR-0015).
#
# Every site fact below is a stamped literal (ADR-0013): `walk-blocker build`
# rewrites the value on each `# GENERATED from` line from site.toml, and the
# in-tree file carries a placeholder sentinel that no build ever ships. Nothing
# here reads configuration at run time.

set -eu

WJ_VERSION='0.1.0'  # GENERATED from VERSION

WJ_SITE_PARTITION='datamover'  # GENERATED from site.toml:slurm.partition
WJ_SITE_QOS='low'  # GENERATED from site.toml:slurm.qos
WJ_SITE_ACCOUNT=''  # GENERATED from site.toml:slurm.account
WJ_SITE_TIME='1:00:00'  # GENERATED from site.toml:slurm.default_time
WJ_SITE_MEM='8G'  # GENERATED from site.toml:slurm.default_mem
WJ_SITE_SBATCH_GLOB='/opt/slurm/*/bin/sbatch'  # GENERATED from site.toml:slurm.sbatch_glob
WJ_NICE='19'  # GENERATED from site.toml:slurm.nice
WJ_SITE_OUT='walk-job-%j.out'  # GENERATED from site.toml:slurm.output_pattern
WJ_SITE_BFS='/usr/bin/bfs'  # GENERATED from site.toml:trusted_binaries.bfs

# The WALK_JOB_* overrides are legitimate, and the difference from the audit
# sinks in the shim and the installer is who is being defended against. Those
# run as root and must not resolve anything through what their caller
# controls. This runs AS the caller, who could already run `sbatch` by hand
# with any option they like -- so an override here grants them nothing, and
# what it buys is a test that can drive every branch.
WJ_PARTITION=${WALK_JOB_PARTITION:-$WJ_SITE_PARTITION}

# Either may be stamped empty when the site does not use it; an empty value
# means the option is not passed at all, so the scheduler applies its own
# default rather than being handed an empty name.
WJ_QOS=${WALK_JOB_QOS:-$WJ_SITE_QOS}
WJ_ACCOUNT=$WJ_SITE_ACCOUNT

# Deliberately modest: a small partition is bounded by its default wall clock,
# and a default generous enough for the largest plausible walk would let one
# user hold it for a shift (ADR-0007). Raising it is a decision the caller
# makes explicitly with -t, which is the point -- the number is visible in
# the command line and in `squeue`, not buried in a config file.
WJ_TIME=${WALK_JOB_TIME:-$WJ_SITE_TIME}

# --mem is ALWAYS passed. A partition configured with DefMemPerNode=UNLIMITED
# does not mean "no reservation" -- a job that names no --mem is charged the
# node's entire memory, and then queues behind any other job on the node with
# an estimated start far in the future, on hardware that is otherwise idle. So
# --mem is not tuning here; it is the difference between the sanctioned
# alternative running now and appearing to be broken.
#
# The site default is generous for a metadata walk. `du` is the one that
# grows: it holds a hardlink table proportional to the number of
# multiply-linked inodes seen.
WJ_MEM=${WALK_JOB_MEM:-$WJ_SITE_MEM}

WJ_OUT=
WJ_DRYRUN=0
WJ_SELF=${0##*/}

wj_die() {
    printf '%s: %s\n' "$WJ_SELF" "$1" >&2
    exit 2
}

# "<partition>[, qos <qos>][, account <account>]" -- what the job runs under,
# naming only the options that will actually be passed.
wj_under() {
    printf '%s' "$WJ_PARTITION"
    if [ -n "$WJ_QOS" ]; then printf ', qos %s' "$WJ_QOS"; fi
    if [ -n "$WJ_ACCOUNT" ]; then printf ', account %s' "$WJ_ACCOUNT"; fi
}

